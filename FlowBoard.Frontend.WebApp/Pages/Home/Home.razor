@page "/"
@using FlowBoard.Frontend.WebApp.Components.Home

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth=@MaxWidth.ExtraLarge
              Class="mt-8">

    <HomeHeader UserName=@_userName />

    <StatsCards BoardsCount=@_boardsCount
                CompletedCount=@_completedCount
                InProgressCount=@_inProgressCount
                MembersCount=@_membersCount />

    <BoardsSection Boards=@_boards
                   ArchivedBoards=@_archivedBoards
                   CurrentUserId=@_currentUserId
                   OnCreateBoard=@OpenCreateBoardDialog
                   OnClick=@NavigateToBoard
                   OnToggleFavorite=@ToggleFavoriteAsync
                   OnEdit=@OpenEditBoardDialog
                   OnArchive=@OpenArchiveConfirmation
                   OnRestore=@OnRestoreBoard
                   OnDelete=@OpenDeleteConfirmation />

</MudContainer>