@page "/"

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">

    <MudText Typo=@Typo.h4 Class="mb-6">
        My Boards
    </MudText>

    <MudButton Variant=@Variant.Filled
               Color=@Color.Primary
               OnClick=@OpenCreateBoardDialog>
        Create Board
    </MudButton>

    <br>
    <br>
    
    @if (_boards == null || !_boards.Any())
    {
        <MudAlert Severity=@Severity.Info 
                  Variant=@Variant.Outlined>
            You don't have any boards yet. Create your first one!
        </MudAlert>
    }
    else
    {
        <MudGrid>

            @foreach (var board in _boards)
            {
                <MudItem xs="12" sm="6" md="4">

                    <MudPaper Elevation="4" 
                              Class="pa-4 hoverable-card" 
                              Style="cursor: pointer; min-height: 120px;"
                              @onclick=@(() => NavigateToBoard(board.Id))>
                        
                        <MudStack Justify=@Justify.SpaceBetween Style="min-height: 110px;">

                            <MudStack Row=@true AlignItems=@AlignItems.Center 
                                      Justify=@Justify.SpaceBetween>

                                <MudText Typo=@Typo.h6 
                                        Class="font-weight-bold">
                                    @board.Name
                                </MudText>

                                <MudStack Row=@true Spacing="1" AlignItems=@AlignItems.Center>

                                    <MudIconButton Icon=@Icons.Material.Filled.Edit 
                                            Color=@Color.Default 
                                            Size=@Size.Small 
                                            OnClick=@(() => OpenEditBoardDialog(board)) />
                                            
                                    <MudIconButton Icon=@Icons.Material.Filled.Delete 
                                                Color=@Color.Error 
                                                Size=@Size.Small 
                                                OnClick=@(() => OpenDeleteConfirmation(board)) />

                                </MudStack>

                            </MudStack>
                                    
                            <MudStack Row=@true AlignItems=@AlignItems.Center>

                                <MudChip T="string" 
                                            Color=@(board.IsPublic 
                                                ? Color.Primary : Color.Secondary) 
                                            Size=@Size.Small>
                                    @(board.IsPublic ? "Public" : "Private")
                                </MudChip>
                        
                                <MudSpacer />
                                
                                <MudText Typo=@Typo.caption 
                                        Color=@Color.Secondary>
                                    Created: @board.CreatedAt.ToShortDateString()
                                </MudText>

                            </MudStack>

                        </MudStack>

                    </MudPaper>

                </MudItem>
            }
        </MudGrid>
    }

</MudContainer>