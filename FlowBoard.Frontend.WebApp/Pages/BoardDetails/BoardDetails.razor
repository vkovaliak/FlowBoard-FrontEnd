@page "/boards/{Id:guid}"
@namespace FlowBoard.Frontend.WebApp.Pages.BoardDetails
@using FlowBoard.Frontend.Domain.Authorization
@using FlowBoard.Frontend.Domain.Enums;
@using FlowBoard.Frontend.WebApp.Components.BoardDetails.Dashboard
@using FlowBoard.Frontend.WebApp.Components.BoardDetails.Table;
@using FlowBoard.Frontend.WebApp.Components.BoardDetails.Calendar;


@if (_isNotFound)
{
    <BoardNotFound />
}
else if (_board == null)
{
    <BoardLoading />
}
else
{
    <div class="flowboard-details-page" 
         style="width: 100%; 
                height: calc(100vh - 64px); 
                display: flex; 
                flex-direction: column; 
                overflow: hidden;">
        
        <BoardHeader BoardName=@_board.Name
                     IsPublic=@_board.IsPublic
                     IsFavorite=@_board.IsFavorite
                     Members=@_board.Members
                     BoardId=@_board.Id
                     CreatedBy=@_board.CreatedBy
                     CurrentUserId=@_currentUserId
                     CurrentUserRole=@_board.UserRole
                     ActiveTab=@_activeTab
                     OnMeetClick=@OpenMeeting
                     OnTabChanged=@HandleTabChanged
                     OnInviteClick=@OpenInviteDialogAsync
                     OnToggleFavorite=@ToggleFavoriteAsync
                     OnMembersChanged=@HandleMembersChangedAsync 
                     OnArchiveClick=@ArchiveBoardAsync
                     FilterCount=@_filter.ActiveCount
                     OnFilterClick=@OpenFilterAsync/>

        @if (_activeTab == BoardViewTab.Board)
        {
            <MudPaper Elevation="0" 
                      Style=@("flex-grow: 1; width: 100%;" +
                            " border-radius:0px; overflow: hidden;" +
                            $"position: relative; {PaperBackgroundStyle}")>

                <div class="board-scroll-wrapper" 
                     style="padding: 35px 25px; height: 100%; 
                            overflow-x: auto; overflow-y: hidden;">

                    @{
                        var canEdit = BoardPermissions.CanModifyContent(
                            _board.UserRole);
                    }

                    <div class="d-flex flex-row flex-nowrap board-lists-container" 
                         style="gap: 24px; height: 100%; align-items: flex-start;">

                        @foreach (var list in _board.Lists.OrderBy(l => l.Position))
                        {
                            <div class="list-draggable-item" 
                                data-list-id="@list.Id" 
                                style="width: 320px; min-width: 280px; 
                                        height: max-content; 
                                        display: flex;">      

                                <TaskList List=@list
                                          BoardId=@_board.Id
                                          AllLists=@_board.Lists
                                          BoardMembers=@_board.Members
                                          CanEdit=@canEdit
                                          OnRenameList=@HandleRenameListAsync
                                          OnDeleteList=@HandleDeleteListAsync
                                          OnCreateCard=@HandleCreateCardAsync
                                          OnUpdateCard=@HandleUpdateCardAsync
                                          OnDeleteCard=@HandleDeleteCardAsync
                                          OnToggleCardComplete=@HandleToggleCardCompleteAsync 
                                          CardFilter=@CardMatchesFilter/>
                            </div>
                        }

                        @if (canEdit)
                        {
                            <div class="flex-shrink-0" style="width: 260px;">
                                <CreateListButtons BoardId=@_board.Id 
                                                   OnListCreate=@CreateListAsync />
                            </div>
                        }
                    </div>
                </div>

            </MudPaper>
        }
        else if (_activeTab == BoardViewTab.Table)
        {
            <BoardTable Board=@_board
                        OnCardUpdated=@HandleTableCardUpdatedAsync />
        }

        else if (_activeTab == BoardViewTab.Calendar)
        {
            <BoardCalendarView Board=@_board
                            OnCardUpdated=@HandleTableCardUpdatedAsync />
        }

        else if (_activeTab == BoardViewTab.Dashboard)
        {
            <BoardDashboardView Board=@_board
                                OnCardUpdated=@HandleTableCardUpdatedAsync />
        }
    </div>
}
