@page "/boards/{Id:guid}"
@namespace FlowBoard.Frontend.WebApp.Pages.BoardDetails

<MudContainer MaxWidth=@MaxWidth.False
              Class="mt-6"
              Style="width: 85vw; overflow: hidden;">
    
    @if (_isNotFound)
    {
        <BoardNotFound />
    }
    else if (_board == null)
    {
        <BoardLoading />
    }
    else
    {
        <BoardHeader BoardName=@_board.Name
                     IsPublic=@_board.IsPublic
                     IsFavorite=@_board.IsFavorite
                     Members=@_board.Members
                     BoardId=@_board.Id
                     CreatedBy=@_board.CreatedBy
                     CurrentUserId=@_currentUserId
                     CurrentUserRole=@_board.UserRole
                     OnInviteClick=@OpenInviteDialogAsync
                     OnToggleFavorite=@ToggleFavoriteAsync
                     OnMembersChanged=@HandleMembersChangedAsync />

        <MudPaper Elevation="2" 
                  Class="pa-4"
                  Style="height: calc(100vh - 220px);
                         width:100%;
                         min-width: 400px;
                         max-width: 100%;
                         overflow: hidden;">

            <div class="board-scroll-wrapper">

                <div class="d-flex flex-row flex-nowrap board-lists-container" 
                        style="gap: 24px; height: 100%; align-items: flex-start;">
                
                    @foreach (var list in _board.Lists.OrderBy(l => l.Position))
                    {
                        <div class="list-draggable-item" 
                            data-list-id="@list.Id" 
                            style="width: 320px; min-width: 280px; 
                                    height: max-content; 
                                    display: flex;">      

                            <TaskList List=@list
                                    BoardId=@_board.Id
                                    AllLists=@_board.Lists
                                    BoardMembers=@_board.Members
                                    OnRenameList=@HandleRenameListAsync
                                    OnDeleteList=@HandleDeleteListAsync
                                    OnCreateCard=@HandleCreateCardAsync
                                    OnUpdateCard=@HandleUpdateCardAsync 
                                    OnDeleteCard=@HandleDeleteCardAsync
                                    OnToggleCardComplete=@HandleToggleCardCompleteAsync /> 
                        </div>
                    }
                    <div class="flex-shrink-0" style="width: 280px;">
                        
                        <CreateListButtons BoardId=@_board.Id 
                                        OnListCreate=@CreateListAsync />
                    </div>

                </div>

            </div>
            
        </MudPaper>
    }

</MudContainer>