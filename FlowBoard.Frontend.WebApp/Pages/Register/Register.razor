@page "/register"
@layout AuthLayout
@using FlowBoard.Frontend.WebApp.Components.Common

<div class="auth-wrapper">

    <div class="auth-container">

        <div class="register-image-side">

            <div class="auth-image-overlay">

                <MudStack Row=@true 
                          AlignItems=@AlignItems.Center 
                          Spacing="2">
                </MudStack>

                <div class="auth-welcome-text">

                    <MudText Typo=@Typo.h4 
                             Style="color: #fff; font-weight: 700;" 
                             Class="mb-8">
                        Your workspace for success
                    </MudText>

                    <MudText Typo=@Typo.body1 
                             Style="color: rgba(255,255,255,0.8); margin-bottom: 14px;">
                        Create your account and start organizing your work in a better way with Flow Board.
                    </MudText>

                </div>

            </div>

        </div>

        <div class="auth-form-side">

            <div class="auth-form-box">

                <MudText Class="mb-4" 
                         Typo=@Typo.h4 
                         Style="font-weight: 700;">
                    Create account
                </MudText>

                <MudText Typo=@Typo.body2 
                         Class="mb-10">
                    Fill in your details to create your account
                </MudText>

                <EditForm Model="@Model" OnValidSubmit=@HandleRegister>

                    <DataAnnotationsValidator />

                    <MudStack Spacing="4">

                        <div>
                            <MudText Typo=@Typo.body2 
                                     Style="font-weight: 800;" 
                                     Class="mb-3">
                                Username
                            </MudText>

                            <MudTextField Variant=@Variant.Outlined
                                          InputType=@InputType.Text
                                          Adornment=@Adornment.Start
                                          AdornmentIcon=@Icons.Material.Outlined.Person
                                          Placeholder="John Doe"
                                          @bind-Value=@Model.UserName
                                          For=@(() => Model.UserName) />
                        </div>

                        <div>
                            <MudText Typo=@Typo.body2 
                                     Style="font-weight: 800;" 
                                     Class="mb-3">
                                Email address
                            </MudText>

                            <MudTextField Variant=@Variant.Outlined
                                          InputType=@InputType.Email
                                          Adornment=@Adornment.Start
                                          AdornmentIcon=@Icons.Material.Outlined.Email
                                          Placeholder="you@example.com"
                                          @bind-Value=@Model.Email
                                          For=@(() => Model.Email) />
                        </div>

                        <div>
                            <MudText Typo=@Typo.body2 
                                     Style="font-weight: 800;" 
                                     Class="mb-3">
                                Password
                            </MudText>

                            <div style="position: relative;">
                                <MudTextField Variant=@Variant.Outlined
                                              InputType=@(_showPassword ? InputType.Text : InputType.Password)
                                              Adornment=@Adornment.Start
                                              AdornmentIcon=@Icons.Material.Outlined.Lock
                                              Placeholder="Create a password"
                                              Immediate=@true
                                              @bind-Value=@Model.Password
                                              For=@(() => Model.Password) />

                                <MudIconButton Icon=@(_showPassword
                                                  ? Icons.Material.Outlined.Visibility
                                                  : Icons.Material.Outlined.VisibilityOff)
                                               Size=@Size.Small
                                               OnClick=@TogglePasswordVisibility
                                               Style="position: absolute; right: 15px; top: 15px;" />
                            </div>
                        </div>

                        <MudStack Spacing="1" 
                                  Class="mt-1">

                            <PasswordRequirement IsMet=@HasMinLength 
                                                 Text="At least 6 characters" />
                            
                            <PasswordRequirement IsMet=@HasUppercase
                                                 Text="At least one uppercase letter" />

                            <PasswordRequirement IsMet=@HasDigit
                                                 Text="At least one number" />

                            <PasswordRequirement IsMet=@HasSpecialChar
                                                 Text="At least one special character" />
                            
                        </MudStack>

                        <MudButton ButtonType=@ButtonType.Submit
                                   Variant=@Variant.Filled
                                   Color=@Color.Primary
                                   FullWidth=@true
                                   Size=@Size.Large
                                   Class="mt-2">
                            Create account
                        </MudButton>

                    </MudStack>

                </EditForm>

                <MudText Typo=@Typo.body2 
                         Align=@Align.Center 
                         Class="mt-6">
                    Already have an account?

                    <MudLink Href="login" 
                             Typo=@Typo.body1 
                             Color=@Color.Primary
                             Class="ml-2" 
                             Style="font-weight: 800;">
                        Sign in
                    </MudLink>
                    
                </MudText>

            </div>

        </div>

    </div>

</div>