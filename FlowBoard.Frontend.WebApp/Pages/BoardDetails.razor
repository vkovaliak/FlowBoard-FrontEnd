@page "/boards/{Id:guid}"
@using FlowBoard.Frontend.Domain.DTOs.Boards
@using FlowBoard.Frontend.Domain.DTOs.Lists
@using FlowBoard.Frontend.WebApp.Components
@using FlowBoard.Frontend.WebApp.Components.BoardDetails

<MudContainer MaxWidth=@MaxWidth.ExtraLarge
              Class="mt-6">
    
    @if (_isNotFound)
    {
        <BoardNotFound />
    }
    else if (_board == null)
    {
        <BoardLoading />
    }
    else
    {
        <BoardHeader BoardName=@_board.Name
                     IsPublic=@_board.IsPublic 
                     OnInviteClick=@OpenInviteDialogAsync/>

        <MudPaper Elevation="2" 
                  Square=@false
                  Outlined=@false
                  Class="pa-4 mud-theme-dark-lighten-2 overflow-x-auto"
                  Style="width: 100%; height: calc(100vh - 220px); 
                         min-height: 400px;">

            <MudDropContainer T=@ListDto
                              Items=@_board.Lists.OrderBy(x => x.Position).ToList()
                              ItemsSelector=@((item, dropzone) => dropzone == "lists")
                              ItemDropped=@HandleListDropped
                              Class="d-flex flex-row flex-nowrap gap-4">

                <ChildContent>

                    <MudDropZone T=@ListDto
                                 Identifier="lists"
                                 AllowReorder=@true
                                 Class="d-flex flex-row flex-nowrap gap-4" />

                    <CreateListButtons BoardId=@_board.Id
                                       OnListCreate=@CreateListAsync />

                </ChildContent>

                <ItemRenderer>

                    <TaskList List=@context
                              BoardId=@_board.Id
                              OnRenameList=@HandleRenameListAsync
                              OnDeleteList=@HandleDeleteListAsync
                              OnCreateCard=@HandleCreateCardAsync
                              OnUpdateCard=@HandleUpdateCardAsync
                              OnDeleteCard=@HandleDeleteCardAsync />

                </ItemRenderer>

            </MudDropContainer>

        </MudPaper>
    }

</MudContainer>