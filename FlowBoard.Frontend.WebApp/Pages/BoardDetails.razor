@page "/boards/{Id:guid}"
@using FlowBoard.Frontend.Domain.DTOs.Boards
@using FlowBoard.Frontend.WebApp.Components

<MudContainer MaxWidth=@MaxWidth.ExtraLarge
              Class="mt-6">
    
    @if (_isNotFound)
    {
        <MudAlert Severity=@Severity.Error 
                  Variant=@Variant.Outlined
                  Class="my-4">
                  Board could not be loaded. Please return to the home page.
        </MudAlert>

        <MudButton Variant=@Variant.Filled
                   Color=@Color.Primary
                   Href="/">
                   Go Home
        </MudButton>
    }
    else if (_board == null)
    {
        <MudStack AlignItems=@AlignItems.Center
                  Class="my-12">

            <MudProgressCircular Color=@Color.Primary 
                                 Size=@Size.Large 
                                 Indeterminate=@true />

            <MudText Typo=@Typo.body1>
                    Loading board details...
            </MudText>

        </MudStack>
    }
    else
    {
        <MudStack Row=@true 
                  AlignItems=@AlignItems.Center
                  Class="mb-6">

            <MudIconButton Icon=@Icons.Material.Filled.ArrowBack 
                           Href="/" 
                           Color=@Color.Default />

            <MudText Typo=@Typo.h4
                     Class="font-weight-bold">
                     @_board.Name
            </MudText>
            
            <MudChip T=@string
                     Color=@(_board.IsPublic ? Color.Primary : Color.Secondary)
                     Size=@Size.Small 
                     Class="ml-2">
                    @(_board.IsPublic ? "Public" : "Private")
            </MudChip>

        </MudStack>

        <MudPaper Elevation="2" 
                  Square=@false
                  Outlined=@false
                  Class="pa-4 mud-theme-dark-lighten-2 overflow-x-auto"
                  Style="width: 100%; height: calc(100vh - 220px); 
                         min-height: 400px;">

            <MudStack Row=@true 
                    Spacing="4" 
                    AlignItems=@AlignItems.Start
                    Class="flex-nowrap overflow-x-auto pb-4"
                    Style="height: 100%; width: 100%;">
            
                @foreach (var list in _board.Lists.OrderBy(l => l.Position))
                {                    
                    <TaskList List=@list
                              BoardId=@_board.Id
                              OnRenameList=@HandleRenameListAsync
                              OnDeleteList=@HandleDeleteListAsync
                              OnCreateCard=@HandleCreateCardAsync
                              OnUpdateCard=@HandleUpdateCardAsync 
                              OnDeleteCard=@HandleDeleteCardAsync /> 
                }
                
                <MudPaper Elevation="0" 
                        Style="width: 250px; min-width: 250px; 
                            background-color: rgba(0,0,0,0.05); 
                            border-radius: 8px; height: max-content;"
                        Class="pa-2 flex-grow-0 flex-shrink-0">

                    @if (!_isCreatingList)
                    {
                        <MudButton StartIcon=@Icons.Material.Filled.Add
                                Color=@Color.Default
                                FullWidth=@true
                                Style="text-transform: none;"
                                OnClick=@ToggleCreateListForm>
                                Add another list
                        </MudButton>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            
                            <MudTextField @bind-Value=@_newListName
                                        Placeholder="Enter list title..." 
                                        Variant=@Variant.Outlined 
                                        Margin=@Margin.Dense
                                        Autofocus=@true
                                        Class="bg-white"
                                        Style="border-radius: 4px;" />

                            <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="2">
                                
                                <MudButton Variant=@Variant.Filled 
                                        Color=@Color.Primary 
                                        Size=@Size.Small
                                        Style="text-transform: none;"
                                        OnClick=@(() => CreateListAsync(_board.Id))>
                                        Add list
                                </MudButton>

                                <MudIconButton Icon=@Icons.Material.Filled.Close
                                            Color=Color.Default 
                                            Size=@Size.Small 
                                            OnClick=@ToggleCreateListForm />
                            </MudStack>

                        </MudStack>
                    }

                </MudPaper>
            
            </MudStack>

        </MudPaper>
    }

</MudContainer>