@page "/boards/{Id:guid}"
@using FlowBoard.Frontend.Domain.DTOs.Boards
@using FlowBoard.Frontend.WebApp.Components

<MudContainer MaxWidth=@MaxWidth.ExtraLarge
              Class="mt-6">
    
    @if (_isNotFound)
    {
        <MudAlert Severity=@Severity.Error 
                  Variant=@Variant.Outlined
                  Class="my-4">
                  Board could not be loaded. Please return to the home page.
        </MudAlert>

        <MudButton Variant=@Variant.Filled
                   Color=@Color.Primary
                   Href="/">
                   Go Home
        </MudButton>
    }
    else if (_board == null)
    {
        <MudStack AlignItems=@AlignItems.Center
                  Class="my-12">

            <MudProgressCircular Color=@Color.Primary 
                                 Size=@Size.Large 
                                 Indeterminate=@true />

            <MudText Typo=@Typo.body1>
                    Loading board details...
            </MudText>

        </MudStack>
    }
    else
    {
        <MudStack Row=@true 
                  AlignItems=@AlignItems.Center
                  Class="mb-6">

            <MudIconButton Icon=@Icons.Material.Filled.ArrowBack 
                           Href="/" 
                           Color=@Color.Default />

            <MudText Typo=@Typo.h4
                     Class="font-weight-bold">
                     @_board.Name
            </MudText>
            
            <MudChip T="string" 
                     Color=@(_board.IsPublic ? Color.Primary : Color.Secondary)
                     Size=@Size.Small 
                     Class="ml-2">
                    @(_board.IsPublic ? "Public" : "Private")
            </MudChip>

        </MudStack>

        <MudStack Row=@true 
                  Spacing="4" 
                  AlignItems=@AlignItems.Start
                  Class="flex-nowrap"
                  Style="width: 100%; height: calc(100vh - 140px); 
                         overflow-x: auto; padding-bottom: 8px;">
        
            @foreach (var list in _board.Lists.OrderBy(l => l.Position))
            {                    
                <TaskList List="@list" /> 
            }
            
            <MudPaper Elevation="0" 
                    Style="width: 250px; min-width: 250px; 
                           background-color: rgba(0,0,0,0.05); 
                           border-radius: 8px; height: max-content;"
                    Class="pa-2 flex-grow-0 flex-shrink-0">

                <MudButton StartIcon=@Icons.Material.Filled.Add
                        Color=@Color.Default
                        FullWidth=@true
                        Style="text-transform: none;">
                        Add another list
                </MudButton>

            </MudPaper>
        
        </MudStack>
    }

</MudContainer>