<div class="mb-6">

    <div class="d-flex align-center px-1 py-2" 
         style="gap: 10px;">

        <MudIcon Icon=@Icon 
                 Color=@IconColor 
                 Size=@Size.Medium />

        <MudText Typo=@Typo.h6 
                 Style="font-weight: 600;">
            @Title
        </MudText>

        <MudChip T=@string 
                 Size=@Size.Small 
                 Variant=@Variant.Filled
                 Color=@IconColor>
            @Tasks.Count
        </MudChip>
        
    </div>

    <MudPaper Elevation="0"
              Style="background-color: white;
                     border-radius: 12px;
                     border: 1px solid var(--mud-palette-divider);
                     overflow: hidden;">

        @if (Tasks.Count == 0)
        {
            <MudText Typo=@Typo.body2 
                     Color=@Color.Secondary 
                     Class="pa-4">
                No tasks
            </MudText>
        }
        else
        {
            @foreach (var task in Tasks)
            {
                <MyTaskRow Task=@task OnClick=@OnTaskClick />
            }
        }
    </MudPaper>

</div>