<div class="board-card 
            @(IsArchived ? "" : "board-card-clickable")"
     @onclick=@HandleCardClick >

    <div class="board-card-cover" 
         style=@CoverStyle >

        <div class="board-card-icon">

            <MudIcon Icon=@Icons.Material.Filled.ViewKanban
                     Style="color: #6366f1;" />

        </div>

        @if (!IsArchived)
        {
            <div @onclick:stopPropagation=@true 
                 class="board-card-star">

                <MudIconButton Icon=@(Board.IsFavorite
                                        ? Icons.Material.Filled.Star
                                        : Icons.Material.Outlined.StarBorder)
                               Color=@(Board.IsFavorite 
                                     ? Color.Warning : Color.Warning)
                               Size=@Size.Medium
                               OnClick=@(() => OnToggleFavorite.InvokeAsync(Board)) />
            </div>
        }

    </div>

    <div class="board-card-body">

        <div class="d-flex align-center justify-space-between">
            <MudText Typo=@Typo.h6 
                     Style="font-weight: 600;">
                @Board.Name
            </MudText>

            <MudChip T=@string
                     Size=@Size.Medium
                     Variant=@Variant.Text
                     Color=@(Board.IsPublic 
                            ? Color.Primary : Color.Tertiary)
                     Style="height: 20px;" >
                @(Board.IsPublic ? "Public" : "Private")
            </MudChip>
        </div>

        <MudText Typo=@Typo.body2
                 Color=@Color.Secondary
                 Class="mt-2"
                 Style="min-height: 30px;">
            Created @Board.CreatedAt.ToShortDateString()
        </MudText>

        <div class="d-flex align-center 
                    justify-space-between">

            @if (!IsArchived && Board.Members.Any())
            {
                <MemberAvatars Members=@Board.Members MaxVisible="3" />
            }
            else
            {
                <span></span>
            }

            @if (HasMenuActions)
            {
                <div @onclick:stopPropagation=@true>
                    <MudMenu Icon=@Icons.Material.Filled.MoreVert
                            Size=@Size.Medium
                            Dense=@true
                            AnchorOrigin=@Origin.BottomRight
                            TransformOrigin=@Origin.TopRight >

                        @if (IsArchived)
                        {
                            <MudMenuItem Icon=@Icons.Material.Filled.Unarchive
                                        Disabled=@true
                                        OnClick=@(() => OnRestore.InvokeAsync(Board))>
                                Restore
                            </MudMenuItem>

                            @if (CanManage)
                            {
                                <MudMenuItem Icon=@Icons.Material.Filled.Delete
                                            IconColor=@Color.Error
                                            OnClick=@(() => OnDelete.InvokeAsync(Board))>
                                    Delete
                                </MudMenuItem>
                            }
                        }
                        else
                        {
                            <MudMenuItem Icon=@Icons.Material.Filled.Edit
                                        OnClick=@(() => OnEdit.InvokeAsync(Board))>
                                Edit
                            </MudMenuItem>

                            <MudMenuItem Icon=@Icons.Material.Outlined.Archive
                                        OnClick=@(() => OnArchive.InvokeAsync(Board))>
                                Archive
                            </MudMenuItem>
                        }
                    </MudMenu>
                </div>
            }

        </div>

    </div>

</div>