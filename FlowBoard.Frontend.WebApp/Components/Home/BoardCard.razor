<MudItem xs="12" sm="6" md="4">
    <MudPaper Elevation="4"
              Class="pa-4 hoverable-card"
              Style=@CardStyle
              @onclick=@HandleCardClick>

        <MudStack Justify=@Justify.SpaceBetween 
                  Style="min-height: 110px;">

            <MudStack Row=@true 
                      AlignItems=@AlignItems.Center
                      Justify=@Justify.SpaceBetween >

                <MudText Typo=@Typo.h6
                         Class="font-weight-bold">
                    @Board.Name
                </MudText>

                <MudStack Row=@true 
                          Spacing="0" 
                          AlignItems=@AlignItems.Center>

                    @if (!IsArchived)
                    {
                        <div @onclick:stopPropagation=@true>

                            <MudIconButton Icon=@(Board.IsFavorite
                                                    ? Icons.Material.Filled.Star
                                                    : Icons.Material.Outlined.StarBorder)
                                           Color=@(Board.IsFavorite ? Color.Warning : Color.Default)
                                           Size=@Size.Medium
                                           OnClick=@(() => OnToggleFavorite.InvokeAsync(Board)) />

                        </div>
                    }


                    @if (HasMenuActions)
                    {
                        <div @onclick:stopPropagation=@true>

                            <MudMenu Icon=@Icons.Material.Filled.MoreVert
                                     Size=@Size.Medium 
                                     Dense=@true
                                     AnchorOrigin=@Origin.BottomRight
                                     TransformOrigin=@Origin.TopRight>

                                @if (IsArchived)
                                {
                                    <MudMenuItem Icon=@Icons.Material.Filled.Unarchive
                                                 Disabled=@true
                                                 OnClick=@(() => OnRestore.InvokeAsync(Board))>
                                        Restore
                                    </MudMenuItem>

                                    @if (CanManage)
                                    {
                                        <MudMenuItem Icon=@Icons.Material.Filled.Delete
                                                     IconColor=@Color.Error
                                                     OnClick=@(() => OnDelete.InvokeAsync(Board))>
                                            Delete
                                        </MudMenuItem>
                                    }
                                }
                                else
                                {
                                    <MudMenuItem Icon=@Icons.Material.Filled.Edit
                                                OnClick=@(() => OnEdit.InvokeAsync(Board))>
                                        Edit
                                    </MudMenuItem>

                                    <MudMenuItem Icon=@Icons.Material.Outlined.Archive
                                                OnClick=@(() => OnArchive.InvokeAsync(Board))>
                                        Archive
                                    </MudMenuItem>
                                }
                            </MudMenu>

                        </div>
                    }


                </MudStack>

            </MudStack>

            <MudStack Row=@true 
                      AlignItems=@AlignItems.Center>

                <MudChip T=@string
                         Color=@(Board.IsPublic 
                            ? Color.Primary : Color.Tertiary)
                         Size=@Size.Small>
                    @(Board.IsPublic ? "Public" : "Private")
                </MudChip>

                <MudSpacer />

                <MudText Typo=@Typo.caption
                         Color=@Color.Secondary>
                    Created: @Board.CreatedAt.ToShortDateString()
                </MudText>

            </MudStack>

        </MudStack>

    </MudPaper>
    
</MudItem>
