@if (Boards is null)
{
    <MudProgressCircular Indeterminate=@true
                         Class="mt-4" />
}
else if (!Boards.Any())
{
    <MudAlert Severity=@Severity.Info 
              Variant=@Variant.Outlined
              Class="mt-4">
        @EmptyMessage
    </MudAlert>
}
else
{
    <MudPaper Class="pa-8 mt-4 rounded-lg" 
              Elevation="1">

        <MudGrid>
            @foreach (var board in Boards)
            {
                <BoardCard Board=@board
                        IsArchived=@IsArchived
                        CurrentUserId=@CurrentUserId
                        OnClick=@OnClick
                        OnToggleFavorite=@OnToggleFavorite
                        OnEdit=@OnEdit
                        OnArchive=@OnArchive
                        OnRestore=@OnRestore
                        OnDelete=@OnDelete />
            }
        </MudGrid>
        
    </MudPaper>
}