<MudStack Row=@true 
            AlignItems=@AlignItems.Center
            Class="mb-6">

    <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="1">

        <MudLink Href="/"
                 Typo=@Typo.h6
                 Color=@Color.Default
                 Underline=@Underline.None
                 Style="font-weight: 500; color: #94A3B8;">
            Boards
        </MudLink>

        <MudText Typo=@Typo.h6 Style="color: #CBD5E1; font-weight: 400;">
            /
        </MudText>

        <MudText Typo=@Typo.h6 Style="font-weight: 700; color: #1E293B;">
            @BoardName
        </MudText>

        <MudIconButton Icon=@(IsFavorite
                            ? Icons.Material.Filled.Star
                            : Icons.Material.Outlined.StarBorder)
                       Color=@(IsFavorite ? Color.Warning : Color.Default)
                       Size=@Size.Small
                       OnClick=@(() => OnToggleFavorite.InvokeAsync()) />
        
    </MudStack>
    
    <MudChip T=@string
                Color=@(IsPublic ? Color.Primary : Color.Tertiary)
                Size=@Size.Small 
                Class="ml-2">
        @(IsPublic ? "Public" : "Private")
    </MudChip>

    <MudSpacer />

    <BoardMembers Members=@Members
                  BoardId=@BoardId
                  CreatedBy=@CreatedBy
                  CurrentUserId=@CurrentUserId
                  CurrentUserRole=@CurrentUserRole
                  OnMembersChanged=@OnMembersChanged />

    @if (CanInvite)
    {
        <MudButton Variant=@Variant.Outlined
                Color=@Color.Primary
                StartIcon=@Icons.Material.Filled.PersonAdd
                Style="text-transform: none;"
                OnClick=@(() => OnInviteClick.InvokeAsync())>
            Invite
        </MudButton>
    }

</MudStack>