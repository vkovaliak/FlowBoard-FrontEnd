@using FlowBoard.Frontend.Domain.Enums

<MudStack Spacing="0" 
          Style="padding: 20px;">

    <MudStack Row=@true 
              AlignItems=@AlignItems.Center 
              Spacing="2" 
              Class="mb-3">

        <MudLink Href="/"
                 Typo=@Typo.h6
                 Color=@Color.Default
                 Underline=@Underline.None
                 Style="font-weight: 500; color: #94A3B8;">
            Boards
        </MudLink>

        <MudText Typo=@Typo.h6 
                 Style="color: #CBD5E1; font-weight: 400;">
            /
        </MudText>

        <MudText Typo=@Typo.h6 
                 Style="font-weight: 700; color: #1E293B;">
            @BoardName
        </MudText>

        <MudIconButton Icon=@(IsFavorite
                            ? Icons.Material.Filled.Star
                            : Icons.Material.Outlined.StarBorder)
                       Color=@(IsFavorite ? Color.Warning : Color.Default)
                       Size=@Size.Small
                       OnClick=@(() => OnToggleFavorite.InvokeAsync()) />

        <MudChip T=@string
                 Color=@(IsPublic ? Color.Primary : Color.Tertiary)
                 Size=@Size.Small 
                 Class="ml-2">
            @(IsPublic ? "Public" : "Private")
        </MudChip>

    </MudStack>

    <MudStack Row=@true 
              AlignItems=@AlignItems.Center>

        <div class="board-view-tabs">

            <button class="board-tab 
                    @(ActiveTab == BoardViewTab.Board ? "board-tab-active" : "")"
                    @onclick=@(() => OnTabChanged.InvokeAsync(BoardViewTab.Board))>

                <MudIcon Icon=@Icons.Material.Outlined.ViewKanban
                         Size=@Size.Small Class="mr-1" />
                Board
            </button>

            @if (IsPro)
            {
                <button class="board-tab 
                        @(ActiveTab == BoardViewTab.Table ? "board-tab-active" : "")"
                        @onclick=@(() => OnTabChanged.InvokeAsync(BoardViewTab.Table))>

                    <MudIcon Icon=@Icons.Material.Outlined.ViewHeadline
                            Size=@Size.Small Class="mr-1" />
                    Table
                </button>

                <button class="board-tab 
                        @(ActiveTab == BoardViewTab.Calendar ? "board-tab-active" : "")"
                        @onclick=@(() => OnTabChanged.InvokeAsync(BoardViewTab.Calendar))>

                    <MudIcon Icon=@Icons.Material.Outlined.CalendarMonth
                            Size=@Size.Small Class="mr-1" />
                    Calendar
                </button>

                <button class="board-tab 
                        @(ActiveTab == BoardViewTab.Dashboard ? "board-tab-active" : "")"
                        @onclick=@(() => OnTabChanged.InvokeAsync(BoardViewTab.Dashboard))>

                    <MudIcon Icon=@Icons.Material.Outlined.BarChart 
                             Size=@Size.Small Class="mr-1" />
                    Dashboard
                </button>
            }
            else
            {
                <button class="board-tab board-tab-locked"
                        @onclick=@UpgradeAsync
                        title="Upgrade to Pro to unlock more views">

                    <MudIcon Icon=@Icons.Material.Outlined.TableChart
                            Size=@Size.Small Class="mr-1" />
                    Table
                    
                    <MudIcon Icon=@Icons.Material.Filled.Lock
                            Size=@Size.Small Class="ml-1"
                            Style="font-size: 14px; opacity: 0.6;" />
                </button>

                <button class="board-tab board-tab-locked"
                        @onclick=@UpgradeAsync
                        title="Upgrade to Pro to unlock more views">

                    <MudIcon Icon=@Icons.Material.Outlined.CalendarMonth
                            Size=@Size.Small Class="mr-1" />
                    Calendar
                    
                    <MudIcon Icon=@Icons.Material.Filled.Lock
                            Size=@Size.Small Class="ml-1"
                            Style="font-size: 14px; opacity: 0.6;" />
                </button>

                <button class="board-tab board-tab-locked"
                        @onclick=@UpgradeAsync
                        title="Upgrade to Pro to unlock more views">

                    <MudIcon Icon=@Icons.Material.Outlined.BarChart
                            Size=@Size.Small Class="mr-1" />
                    Dashboard
                    
                    <MudIcon Icon=@Icons.Material.Filled.Lock
                            Size=@Size.Small Class="ml-1"
                            Style="font-size: 14px; opacity: 0.6;" />
                </button>
            }
            
        </div>

        <MudSpacer />

        <BoardMembers Members=@Members
                      BoardId=@BoardId
                      CreatedBy=@CreatedBy
                      CurrentUserId=@CurrentUserId
                      CurrentUserRole=@CurrentUserRole
                      OnMembersChanged=@OnMembersChanged />

        @if (CanInvite)
        {
            <MudButton Variant=@Variant.Outlined
                       Color=@Color.Default
                       Size=@Size.Large
                       StartIcon=@Icons.Material.Outlined.PersonAddAlt
                       Class="ml-3"
                       Style="text-transform: none;
                              border: 2px solid #e7dbdbde;
                              border-radius: 5px;
                              background: #e5e0e03b"
                       OnClick=@(() => OnInviteClick.InvokeAsync())>
                Invite
            </MudButton>
        }

        <div @onclick:stopPropagation="true">
            <MudMenu Icon=@Icons.Material.Filled.MoreVert
                    Size=@Size.Medium
                    Dense=@true
                    AnchorOrigin=@Origin.BottomRight
                    TransformOrigin=@Origin.TopRight>

                <MudMenuItem Icon=@Icons.Material.Outlined.Group
                            OnClick=@OnMeetClick>
                    Meeting
                </MudMenuItem>

                @if (IsOwner)
                {
                    <MudDivider Class="my-1" />

                    <MudMenuItem Icon=@Icons.Material.Outlined.Archive
                                OnClick=@(() => OnArchiveClick.InvokeAsync())>
                        Archive board
                    </MudMenuItem>
                }

            </MudMenu>

        </div>

    </MudStack>

</MudStack>