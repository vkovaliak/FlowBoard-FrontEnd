@using System.Globalization
@using FlowBoard.Frontend.WebApp.Components.Common

<div class="board-table-wrapper">

    <MudPaper Elevation="0" 
              Class="board-table-card">

        <table class="board-table">

            <thead>

                <tr>
                    <th style="width: 30%;">Card</th>
                    <th style="width: 12%;">List</th>
                    <th style="width: 14%;">Assignees</th>
                    <th style="width: 12%;">Due date</th>
                    <th style="width: 20%;">Labels</th>
                    <th style="width: 12%;">Checklist</th>
                </tr>

            </thead>

            <tbody>
                @foreach (var row in GetRows())
                {
                    <tr class="board-table-row" 
                        @onclick=@(() => OpenCardAsync(row))>

                        <td>

                            <div class="tbl-card-title 
                                 @(row.Card.IsCompleted ? "tbl-completed" : "")">

                                @if (row.Card.IsCompleted)
                                {
                                    <MudIcon Icon=@Icons.Material.Filled.CheckCircle
                                             Size=@Size.Small
                                             Color=@Color.Primary
                                             Class="mr-1" />
                                }
                                @row.Card.Name
                            </div>

                            @if (!string.IsNullOrWhiteSpace(row.Card.Description))
                            {
                                <MudText Typo=@Typo.body2
                                        Class="task-description"
                                        Style="overflow: hidden; display: -webkit-box;;
                                                -webkit-line-clamp: 2;-webkit-box-orient: vertical;">
                                    @((MarkupString)row.Card.Description)
                                </MudText>
                            }
                        </td>

                        <td>
                            <span class="tbl-list-chip">
                                @row.ListName
                            </span>
                        </td>

                        <td>
                            @if (row.Card.Assignees.Any())
                            {
                                <div class="tbl-assignees">
                                    @foreach (var a in row.Card.Assignees.Take(3))
                                    {
                                        <UserAvatar UserName=@a.UserName
                                                    AvatarUrl=@a.AvatarUrl
                                                    Size=@Size.Medium
                                                    SizeStyle="width: 34px; height: 34px;
                                                               font-size: 16px;
                                                               border: 2px solid white;" />
                                    }
                                    @if (row.Card.Assignees.Count > 3)
                                    {
                                        <MudAvatar Style="width: 34px; height: 34px;
                                                          font-size: 15px;
                                                          background-color: #6b778c;
                                                          color: white;
                                                          border: 2px solid white;">
                                            +@(row.Card.Assignees.Count - 3)
                                        </MudAvatar>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="tbl-empty">—</span>
                            }
                        </td>

                        <td>
                            @if (row.Card.DueDate != default)
                            {
                                <div class="tbl-due @GetDueClass(row.Card)">
                                    <MudIcon Icon=@Icons.Material.Outlined.CalendarToday
                                             Size=@Size.Medium
                                             Style="font-size: 22px;" />
                                    <span>
                                        @row.Card.DueDate?.ToString(
                                            "d MMM", CultureInfo.InvariantCulture)
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="tbl-empty">—</span>
                            }
                        </td>

                        <td>
                            @if (row.Card.Labels.Any())
                            {
                                <div class="tbl-labels">
                                    @foreach (var label in row.Card.Labels)
                                    {
                                        <span class="tbl-label"
                                              style=@($"background-color: {label.Color};")>
                                            @label.Name
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="tbl-empty">—</span>
                            }
                        </td>

                        <td>
                            @if (row.Card.ChecklistItems.Any())
                            {
                                var done = row.Card.ChecklistItems.Count(
                                    i => i.IsCompleted);

                                var total = row.Card.ChecklistItems.Count;
                                
                                <div class="tbl-checklist 
                                     @(done == total ? "tbl-checklist-done" : "")">

                                    <MudIcon Icon=@Icons.Material.Outlined.CheckBox
                                             Size=@Size.Small
                                             Style="font-size: 22px;" />

                                    <span>
                                        @done/@total
                                    </span>

                                </div>
                            }
                            else
                            {
                                <span class="tbl-empty">—</span>
                            }
                        </td>

                    </tr>
                }

                @if (!GetRows().Any())
                {
                    <tr>
                        <td colspan="6" 
                            class="tbl-empty-state">

                            <MudIcon Icon=@Icons.Material.Outlined.TableRows
                                     Size=@Size.Large
                                     Style="color: #cbd5e1;" />

                            <div>No cards yet</div>

                        </td>
                    </tr>
                }
            </tbody>
            
        </table>

    </MudPaper>

</div>