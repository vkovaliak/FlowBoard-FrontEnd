<MudPaper Elevation="0" Class="pa-5"
          Style="border: 2px solid #edeff2; 
                 border-radius: 12px;">

    <MudText Typo=@Typo.h6 
             Style="font-weight: 700;" 
             Class="mb-3">
        Labels Distribution
    </MudText>

    @if (_labels.Count == 0)
    {
        <MudText Typo=@Typo.body2 Color=@Color.Secondary>
            No labels used
        </MudText>
    }
    else
    {
        @foreach (var l in _labels)
        {
            <div class="d-flex align-center mb-3" 
                 style="gap: 12px;">

                <span style=@($"width: 18px; height: 18px;" +
                              $" border-radius: 3px;" +
                              $"flex-shrink: 0; background-color: {l.Color};")>
                </span>

                <MudText Typo=@Typo.body2 
                         Style="width: 165px;
                                overflow: hidden; 
                                text-overflow: ellipsis;
                                white-space: nowrap;">
                    @l.Name
                </MudText>

                <MudProgressLinear Value=@GetPercent(l.Count)
                                   Style=@($"flex-grow: 1; height: 6px;" +
                                           $"border-radius: 3px;")
                                   Color=@Color.Primary />

                <MudText Typo=@Typo.body2 Color=@Color.Secondary>
                    @l.Count
                </MudText>

            </div>
        }
    }

</MudPaper>