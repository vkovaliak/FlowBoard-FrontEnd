@using FlowBoard.Frontend.WebApp.Components.Home

<MudGrid Spacing="6" Class="mb-4">

    <MudItem xs="12" sm="6" md="3">

        <StatCard Icon=@Icons.Material.Filled.Assignment
                  Value=@TotalCount.ToString()
                  Label="Total Tasks"
                  IconBg="#eef2ff"
                  IconColor="#6366f1" />
    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <StatCard Icon=@Icons.Material.Filled.Schedule
                  Value=@InProgressCount.ToString()
                  Label="In Progress"
                  IconBg="#fffbeb"
                  IconColor="#f59e0b" />
    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <StatCard Icon=@Icons.Material.Filled.CheckCircle
                  Value=@CompletedCount.ToString()
                  Label="Completed"
                  IconBg="#ecfdf5"
                  IconColor="#10b981" />
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        
        <StatCard Icon=@Icons.Material.Filled.Schedule
                  Value=@OverdueCount.ToString()
                  Label="Overdue"
                  IconBg="#fef2f2"
                  IconColor="#ef4444" />
    </MudItem>

</MudGrid>