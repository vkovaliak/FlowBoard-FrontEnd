<MudPaper Elevation="3"
          Class="pa-3 d-flex flex-column"
          Style="flex: 1; min-width: 23%;
                 background-color: #f4f5f7;
                 max-height: 74vh;
                 border-radius: 8px;">

    <TaskListHeader ListName=@List.Name
                    CardsCount=@(List.Cards?.Count ?? 0)
                    CanEdit=@CanEdit
                    OnAddCardClick=@OpenCreateCardForm
                    OnDeleteClick=@DeleteListClickAsync
                    OnRename=@RenameListAsync />

    <MudStack Spacing="2"
              Class="flex-grow-1 cards-drop-zone"
              Style="overflow-y: auto; max-height: 70vh; min-height: 15px;"
              data-list-id=@List.Id>

        @if (List.Cards != null && List.Cards.Any())
        {
            @foreach (var card in FilteredCards)
            {
                <div data-card-id="@card.Id" style="width: 100%;">
                    <CardItem Card=@card
                              CanEdit=@CanEdit
                              OnDelete=@DeleteCardClickAsync
                              OnEdit=@OpenCardDetailsAsync 
                              OnToggleComplete=@OnToggleCardComplete 
                              OnDuplicate=@DuplicateCardClickAsync />
                </div>
            }
        }

    </MudStack>

    <CreateCardForm @ref=@_createCardForm
                    CanEdit=@CanEdit
                    OnCreate=@CreateCardAsync />    
                    
</MudPaper>