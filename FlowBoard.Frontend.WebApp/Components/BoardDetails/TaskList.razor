@using FlowBoard.Frontend.Domain.DTOs.Cards

<MudPaper Elevation="3" 
        Class="pa-3 d-flex flex-column" 
        Style="flex: 1; min-width: 23%; 
                background-color: #f4f5f7; 
                border-radius: 8px;">
    
    <MudStack Row="true" Justify=@Justify.SpaceBetween
                AlignItems=@AlignItems.Center
                Class="mb-3 flex-grow-0 list-drag-handle"
                Style="cursor: grab; user-select: none;">
        @if (!_isEditingName)
        {
            <MudStack Row=@true AlignItems=@AlignItems.Center 
                      Spacing="2"
                      Class="flex-grow-1">

                <MudText Typo=@Typo.h6 Class="font-weight-bold px-1"
                        Style="cursor: grab;">
                    @List.Name
                </MudText>

                <MudChip T=@string
                         Variant=@Variant.Filled
                         Color=@Color.Default
                         Size=@Size.Small
                         Disabled=@true
                         Style="background-color: #091e4214; 4
                                color: #42526e; font-weight: 600; 
                                min-width: 20px; height: 20px; 
                                border-radius: 4px; padding: 0 6px; margin: 0;">
                    @(List.Cards?.Count)
                </MudChip>
            
            </MudStack>

            <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="0">

                <MudIconButton Icon=@Icons.Material.Filled.Add
                               Size=@Size.Small
                               Color=@Color.Default
                               OnClick=@ToggleCreateCardForm
                               Style="color: #42526e; padding: 4px;" />

                <MudMenu Icon=@Icons.Material.Filled.MoreVert
                        Size=@Size.Small 
                        Dense=@true 
                        AnchorOrigin=@Origin.BottomRight 
                        TransformOrigin=@Origin.TopRight>

                    <MudMenuItem Icon=@Icons.Material.Filled.Edit 
                                OnClick=@StartRename>
                        Rename
                    </MudMenuItem>

                    <MudMenuItem Icon=@Icons.Material.Filled.Delete 
                                IconColor=@Color.Error 
                                OnClick=@DeleteListClickAsync>
                        Delete
                    </MudMenuItem>
                    
                </MudMenu>
            
            </MudStack>
        }
        else
        {
            <MudStack Spacing="2" Class="flex-grow-1 mr-1">
                <MudTextField @bind-Value=@_editedName
                            Variant=@Variant.Outlined
                            Margin=@Margin.Dense
                            Autofocus=@true
                            Class="bg-white flex-grow-1 mr-1"
                            Style="font-weight: 600;"
                            OnBlur=@SaveRenameAsync />

                <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="2">
                    <MudButton Variant=@Variant.Filled 
                               Color=@Color.Primary 
                               Size=@Size.Small
                               Style="text-transform: none;"
                               OnClick=@SaveRenameAsync>
                        Save
                    </MudButton>

                    <MudIconButton Icon=@Icons.Material.Filled.Close
                                   Color=@Color.Default 
                                   Size=@Size.Small 
                                   OnClick=@CancelRename />
                </MudStack>
            </MudStack>
        }

    </MudStack>

    <MudStack Spacing="2" 
              Class="flex-grow-1 cards-drop-zone" 
              Style="overflow-y: auto; max-height: 60vh; min-height: 40px;"
              data-list-id=@List.Id>
        
        @if (List.Cards != null && List.Cards.Any())
        {
            @foreach (var card in List.Cards.OrderBy(c => c.Position))
            {
                <div data-card-id="@card.Id" style="width: 100%;">
                    <CardItem Card=@card 
                            OnDelete=@DeleteCardClickAsync 
                            OnEdit=@OpenCardDetailsAsync>
                    </CardItem>
                </div>
            }
        }

    </MudStack>

        @if (!_isCreatingCard)
        {
            <MudButton StartIcon=@Icons.Material.Filled.Add
                       Color=@Color.Default
                       FullWidth=@true 
                       Class="justify-start pa-2"
                       Style="text-transform: none; color: #5e6c84;"
                       OnClick=@ToggleCreateCardForm>
                       Add a card
            </MudButton>
        }
        else
        {
            <EditForm Model="@_cardForm">

                <DataAnnotationsValidator />

                <MudStack Spacing="2" Class="pa-1">

                    <MudTextField @bind-Value=@_cardForm.Name
                                Placeholder="Enter card title..." 
                                Variant=@Variant.Outlined 
                                Margin=@Margin.Dense
                                Autofocus=@true
                                Class="bg-white" 
                                For=@(() => _cardForm.Name) />

                    <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="2">
                    
                        <MudButton Variant=@Variant.Filled 
                                Color=@Color.Primary 
                                Size=@Size.Small
                                Style="text-transform: none;"
                                OnClick=@SubmitCreateCardAsync>
                            Add card
                        </MudButton>

                        <MudIconButton Icon=@Icons.Material.Filled.Close
                                    Color=@Color.Default 
                                    Size=@Size.Small 
                                    OnClick=@ToggleCreateCardForm />
                    </MudStack>

                </MudStack>
            
            </EditForm>
        }

</MudPaper>