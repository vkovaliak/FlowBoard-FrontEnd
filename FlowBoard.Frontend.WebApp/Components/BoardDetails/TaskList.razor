@using FlowBoard.Frontend.Domain.DTOs.Cards

<MudPaper Elevation="3" 
        Class="pa-3 d-flex flex-column" 
        Style="flex: 1; min-width: 23%; 
                background-color: #f4f5f7; 
                border-radius: 8px;">
    
    <MudStack Row="true" Justify=@Justify.SpaceBetween
                AlignItems=@AlignItems.Center
                Class="mb-3 flex-grow-0">
        @if (!_isEditingName)
        {
            <MudText Typo=@Typo.subtitle1 Class="font-weight-bold px-1">
                @List.Name
            </MudText>

            <MudMenu Icon=@Icons.Material.Filled.MoreHoriz 
                     Size=@Size.Small 
                     Dense=@true 
                     AnchorOrigin=@Origin.BottomRight 
                     TransformOrigin=@Origin.TopRight>

                <MudMenuItem Icon=@Icons.Material.Filled.Edit 
                             OnClick=@StartRename>
                    Rename
                </MudMenuItem>

                <MudMenuItem Icon=@Icons.Material.Filled.Delete 
                             IconColor=@Color.Error 
                             OnClick=@DeleteListClickAsync>
                    Delete
                </MudMenuItem>
                
            </MudMenu>
        }
        else
        {
            <MudStack Spacing="2" Class="flex-grow-1 mr-1">
                <MudTextField @bind-Value=@_editedName
                            Variant=@Variant.Outlined
                            Margin=@Margin.Dense
                            Autofocus=@true
                            Class="bg-white flex-grow-1 mr-1"
                            Style="font-weight: 600;"
                            OnBlur=@SaveRenameAsync />

                <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="2">
                    <MudButton Variant=@Variant.Filled 
                               Color=@Color.Primary 
                               Size=@Size.Small
                               Style="text-transform: none;"
                               OnClick=@SaveRenameAsync>
                        Save
                    </MudButton>

                    <MudIconButton Icon=@Icons.Material.Filled.Close
                                   Color=@Color.Default 
                                   Size=@Size.Small 
                                   OnClick=@CancelRename />
                </MudStack>
            </MudStack>
        }

    </MudStack>

    <MudStack Spacing="2" Class="flex-grow-1" 
                Style="overflow-y: auto; max-height: 60vh;">
        
        @if (List.Cards != null && List.Cards.Any())
        {
            @foreach (var card in List.Cards.OrderBy(c => c.Position))
            {
                <CardItem Card=@card 
                          OnDelete=@DeleteCardClickAsync 
                          OnEdit=@OpenCardDetailsAsync>
                </CardItem>
            }
        }

    </MudStack>

        @if (!_isCreatingCard)
        {
            <MudButton StartIcon=@Icons.Material.Filled.Add
                       Color=@Color.Default
                       FullWidth=@true 
                       Class="justify-start pa-2"
                       Style="text-transform: none; color: #5e6c84;"
                       OnClick=@ToggleCreateCardForm>
                       Add a card
            </MudButton>
        }
        else
        {
            <MudStack Spacing="2" Class="pa-1">
                <MudTextField @bind-Value=@_cardForm.Name
                              Placeholder="Enter card title..." 
                              Variant=@Variant.Outlined 
                              Margin=@Margin.Dense
                              Autofocus=@true
                              Class="bg-white" />

                <MudTextField @bind-Value=@_cardForm.Description
                              Placeholder="Enter description (optional)..." 
                              Variant=@Variant.Outlined 
                              Margin=@Margin.Dense
                              Lines="2"
                              Class="bg-white" />

                <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="2">
                    <MudButton Variant=@Variant.Filled 
                               Color=@Color.Primary 
                               Size=@Size.Small
                               Style="text-transform: none;"
                               OnClick=@SubmitCreateCardAsync>
                               Add card
                    </MudButton>

                    <MudIconButton Icon=@Icons.Material.Filled.Close
                                   Color=@Color.Default 
                                   Size=@Size.Small 
                                   OnClick=@ToggleCreateCardForm />
                </MudStack>
            </MudStack>
        }

</MudPaper>