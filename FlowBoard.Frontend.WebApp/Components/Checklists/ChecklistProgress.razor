@if (Total > 0)
{
    <MudStack Row=@true
              AlignItems=@AlignItems.Center
              Spacing="2"
              Class="@Class">

        <MudProgressLinear Value=@Percentage
                           Color=@Color.Primary
                           Rounded=@true
                           Style="flex-grow: 1; height: 6px;" />

        @if (IsCompleted)
        {
            <MudIcon Icon=@Icons.Material.Filled.CheckCircle
                     Size=@Size.Small
                     Style=@($"color: {CheckColor}; font-size: 18px; {TextShadow}") />
        }
        else
        {
            <MudText Typo=@Typo.caption
                     Style=@($"color: {TextColor}; min-width: 32px; {TextShadow}")>
                @($"{(int)Percentage}%")
            </MudText>
        }

    </MudStack>
}