@if (Total > 0)
{
    <MudStack Row=@true
              AlignItems=@AlignItems.Center
              Spacing="2"
              Class="@Class">

        <MudProgressLinear Value=@Percentage
                           Color=@Color.Primary
                           Rounded=@true
                           Style="flex-grow: 1; height: 6px;" />

        @if (IsCompleted)
        {
            <MudIcon Icon=@Icons.Material.Filled.CheckCircle
                     Size=@Size.Small
                     Style="color: #2563EB; font-size: 18px;" />
        }
        else
        {
            <MudText Typo=@Typo.caption
                     Style="color: #64748B; min-width: 32px;">
                @($"{(int)Percentage}%")
            </MudText>
        }

    </MudStack>
}