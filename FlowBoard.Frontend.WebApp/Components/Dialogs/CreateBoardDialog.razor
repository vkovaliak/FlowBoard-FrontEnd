@using FlowBoard.Frontend.Domain.Models.Boards

<MudDialog>

    <TitleContent>

        <MudText Typo=@Typo.h6>
            @(IsEditMode ? "Edit Board" : "Create New Board")
        </MudText>
        
    </TitleContent>

    <DialogContent>

        <EditForm Model="@Model">

            <DataAnnotationsValidator />

            <MudTextField Label="Board Name"
                        Variant=@Variant.Outlined
                        Margin=@Margin.Dense
                        @bind-Value=@Model.Name 
                        For=@(() => Model.Name) />

            <MudRadioGroup T="bool" @bind-Value=@Model.IsPublic 
                        Class="mt-4 d-flex flex-column">

                <MudRadio Value=@false 
                        Color=@Color.Primary>
                    Private
                </MudRadio>

                <MudRadio Value=@true 
                        Color=@Color.Primary>
                    Public
                </MudRadio>

            </MudRadioGroup>

        </EditForm>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel>Cancel</MudButton>

        <MudButton Color=@Color.Primary 
                   ButtonType=@ButtonType.Submit
                   Variant=@Variant.Filled 
                   OnClick=@Submit>
            @(IsEditMode ? "Save Changes" : "Create")
        </MudButton>

    </DialogActions>

</MudDialog>