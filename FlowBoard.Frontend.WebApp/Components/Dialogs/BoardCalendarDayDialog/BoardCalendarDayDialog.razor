@using System.Globalization

<MudDialog>

    <TitleContent>

        <div class="d-flex align-center" 
             style="gap: 10px;">

            <MudIcon Icon=@Icons.Material.Filled.CalendarToday
                     Color=@Color.Primary />

            <MudText Typo=@Typo.h6 
                     Style="font-weight: 600;">
                @Date.ToString(
                    "dddd, MMM d", CultureInfo.InvariantCulture)
            </MudText>

        </div>

    </TitleContent>

    <DialogContent>

        <div style="min-width: 340px; 
                    max-height: 400px; 
                    overflow-y: auto;">

            @if (Cards.Count == 0)
            {
                <MudText Typo=@Typo.body2 
                         Color=@Color.Secondary 
                         Class="pa-4">
                    No tasks
                </MudText>
            }
            else
            {
                @foreach (var card in Cards)
                {
                    <div class="d-flex align-center"
                         style="gap: 8px; padding: 10px 12px; 
                                cursor: pointer;
                                border-radius: 8px; 
                                margin-bottom: 4px;
                                transition: background-color 0.15s;"
                         @onclick=@(() => OnCardClicked(card))>

                        <div class="d-flex" 
                             style="gap: 3px; flex-shrink: 0;">

                            @foreach (var label in card.Labels.Take(3))
                            {
                                <span style=@($"width: 8px; height: 8px; " +
                                              $"border-radius: 50%; " +
                                              $"background-color: {label.Color};")>
                                </span>
                            }
                            @if (card.Labels.Count == 0)
                            {
                                <span style="width: 8px; height: 8px;
                                             border-radius: 50%;
                                             background-color: #ADB5BD;">
                                </span>
                            }
                        </div>

                        <div style="flex-grow: 1; min-width: 0;">

                            <MudText Typo=@Typo.body2
                                     Style="font-weight: 500;
                                            overflow: hidden;
                                            text-overflow: ellipsis;
                                            white-space: nowrap;">
                                @card.Name
                            </MudText>

                        </div>

                        <MudIcon Icon=@Icons.Material.Filled.ChevronRight
                                 Size=@Size.Small
                                 Color=@Color.Secondary
                                 Class="ml-4" />

                    </div>
                }
            }

        </div>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel>
            Close
        </MudButton>

    </DialogActions>

</MudDialog>