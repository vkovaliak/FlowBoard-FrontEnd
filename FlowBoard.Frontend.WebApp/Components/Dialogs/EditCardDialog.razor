@using FlowBoard.Frontend.Domain.DTOs.Cards
@using FlowBoard.Frontend.Domain.Models.Cards

<MudDialog>

    <TitleContent>

        <MudText Typo=@Typo.h6>

            <MudIcon Icon=@Icons.Material.Filled.CreditCard 
                          Class="mr-2" />
                Edit Card

        </MudText>

    </TitleContent>

    <DialogContent>

        <EditForm Model="@_model">
            
            <DataAnnotationsValidator />

            <MudStack Spacing="3">

                <MudTextField @bind-Value=@_model.Name
                            Label="Card Name" 
                            Variant=@Variant.Outlined
                            Margin=@Margin.Dense
                            Required=@true
                            RequiredError="Card name cannot be empty" 
                            For=@(() => _model.Name) />

                <MudStack Spacing="1">

                    <MudText Typo=@Typo.caption
                             Color=@Color.Secondary 
                             Class="ml-1">
                        Description
                    </MudText>

                    @if (!_isEditingDescription)
                    {
                        <MudPaper Class="pa-2 mb-2" Outlined=@true>

                            <InputFile OnChange=@HandleFileSelected multiple />

                        </MudPaper>

                        <MudPaper Outlined=@true
                                  Class="pa-3" 
                                  Style="cursor: pointer; min-height: 80px; 
                                         border-color: var(--mud-palette-lines-inputs);"
                                  @onclick=@EnableDescriptionEditing>

                            @if (string.IsNullOrWhiteSpace(_model.Description))
                            {
                                <MudText Typo=@Typo.body2 
                                         Color=@Color.Secondary 
                                         Style="font-style: italic;">
                                    Add a more detailed description (Click to format text)...
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo=@Typo.body2>
                                    @((MarkupString)_model.Description)
                                </MudText>
                            }
                        </MudPaper>
                    }
                    else
                    {
                        <Editor ApiKey="ril1s7tjuhstzun5vtt9z4mxgpe0fpoxjohfi3vumix7zf2v"
                                @bind-Value=@_model.Description
                                Field=@(() => _model.Description)
                                Conf="@_editorConfig" />

                        <MudStack Row=@true 
                                  Justify=@Justify.FlexEnd 
                                  Class="mt-1">

                            <MudButton Variant=@Variant.Text 
                                       Color=@Color.Secondary 
                                       Size=@Size.Small
                                       OnClick=@CancelDescriptionEditing>
                                Close Editor
                            </MudButton>
                        </MudStack>
                    }

                </MudStack>
                
                <MudDivider Class="my-2" />

                <MudText Typo=@Typo.subtitle1 
                         Class="font-weight-bold">
                    Comments
                </MudText>

                <MudStack Row=@true 
                          AlignItems=@AlignItems.Center 
                          Spacing="2">
                    @if (!_isWritingComment)
                    {
                        <MudPaper Outlined=@true
                                Class="pa-3"
                                Style="cursor:pointer;"
                                @onclick=@(()=>_isWritingComment = true) >

                            <MudText Color=@Color.Secondary>
                                Write a comment...
                            </MudText>

                        </MudPaper>
                    }
                    else
                    {
                        <MudStack Spacing="2">

                        <Editor ApiKey="ril1s7tjuhstzun5vtt9z4mxgpe0fpoxjohfi3vumix7zf2v"
                                @bind-Value=@_newCommentMessage
                                Field=@(() => _newCommentMessage)
                                Conf=@_editorConfig />

                            <MudStack Row=@true
                                      Justify=@Justify.FlexEnd
                                      Class="mt-2">

                                <MudButton Variant=@Variant.Text
                                           OnClick=@CancelNewComment>
                                    Cancel
                                </MudButton>

                                <MudButton Variant=@Variant.Filled
                                           Color=@Color.Primary
                                           Disabled=@string.IsNullOrWhiteSpace(_newCommentMessage)
                                           OnClick=@SendCommentAsync>
                                    Add
                                </MudButton>

                            </MudStack>

                        </MudStack>
                    }

                </MudStack>

                <MudStack Spacing="2" 
                          Style="max-height: 200px; overflow-y: auto;" 
                          Class="mt-2">

                    @if (_isLoadingComments)
                    {
                        <MudProgressCircular Color=@Color.Primary 
                                             Indeterminate=@true 
                                             Size=@Size.Small />
                    }
                    else if (!_comments.Any())
                    {
                        <MudText Typo=@Typo.body2 
                                 Color=@Color.Secondary>
                            No comments yet.
                        </MudText>
                    }
                    else
                    {
                        @foreach (var comment in _comments)
                        {
                            <MudPaper Class="pa-3 my-1 bg-light" 
                                      Outlined=@true>

                                <MudStack Row=@true 
                                          Justify=@Justify.SpaceBetween 
                                          AlignItems=@AlignItems.Center>

                                    <MudStack Row=@true 
                                              Spacing="2" 
                                              AlignItems=@AlignItems.Center>

                                        <MudText Typo=@Typo.caption 
                                                 Class="font-weight-bold">
                                            @comment.Email
                                        </MudText>

                                        <MudText Typo=@Typo.caption 
                                                 Color=@Color.Secondary>
                                            @comment.CreatedAt.ToString("g")
                                        </MudText>

                                    </MudStack>

                                    <MudStack Row=@true Spacing="1">

                                        @if (_editingCommentId != comment.Id)
                                        {
                                            <MudIconButton Icon=@Icons.Material.Filled.Edit 
                                                           Size=@Size.Small 
                                                           Color=@Color.Default
                                                           OnClick=@(() => StartEditComment(comment)) />

                                            <MudIconButton Icon=@Icons.Material.Filled.Delete
                                                           Size=@Size.Small 
                                                           Color=@Color.Error
                                                           OnClick=@(() => DeleteCommentAsync(comment.Id)) />
                                        }
                                    </MudStack>

                                </MudStack>

                                @if (_editingCommentId == comment.Id)
                                {
                                    <MudStack Class="mt-2" Spacing="2">

                                        <Editor ApiKey="ril1s7tjuhstzun5vtt9z4mxgpe0fpoxjohfi3vumix7zf2v"
                                            @bind-Value=@_editingCommentMessage
                                            Field=@(() => _newCommentMessage)
                                            Conf=@_editorConfig />

                                        <MudStack Row=@true 
                                                  Justify=@Justify.FlexEnd 
                                                  Spacing="2">

                                            <MudButton Size=@Size.Small
                                                       Variant=@Variant.Text
                                                       Color=@Color.Secondary
                                                       OnClick=@CancelEditComment>
                                                Cancel
                                            </MudButton>

                                            <MudButton Size=@Size.Small
                                                    Variant=@Variant.Filled
                                                    Color=@Color.Primary
                                                    Disabled=@string.IsNullOrWhiteSpace(_editingCommentMessage)
                                                    OnClick=@SaveCommentUpdateAsync>
                                                Save
                                            </MudButton>

                                        </MudStack>

                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo=@Typo.body2 
                                             Class="mt-1" 
                                             Style="white-space: pre-wrap;">
                                        @((MarkupString)comment.Message)
                                    </MudText>
                                }
                                
                            </MudPaper>
                        }
                    }
                </MudStack>

            </MudStack>
        
        </EditForm>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel 
                   Variant=@Variant.Text>
            Cancel
        </MudButton>

        <MudButton Color=@Color.Primary
                   ButtonType=@ButtonType.Submit
                   Variant=@Variant.Filled 
                   OnClick=@SaveAsync>
            Save
        </MudButton>

    </DialogActions>

</MudDialog>