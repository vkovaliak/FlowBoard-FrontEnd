@using FlowBoard.Frontend.Domain.DTOs.Cards
@using FlowBoard.Frontend.Domain.Models.Cards

<MudDialog>

    <TitleContent>

        <MudText Typo=@Typo.h6>

            <MudIcon Icon=@Icons.Material.Filled.CreditCard 
                          Class="mr-2" />
                Edit Card

        </MudText>

    </TitleContent>

    <DialogContent>

        <MudStack Spacing="3">

            <MudTextField @bind-Value=@_model.Name
                          Label="Card Name" 
                          Variant=@Variant.Outlined
                          Margin=@Margin.Dense
                          Required=@true
                          RequiredError="Card name cannot be empty" />

            <MudTextField @bind-Value=@_model.Description 
                          Label="Description" 
                          Variant=@Variant.Outlined
                          Lines="3" />
        </MudStack>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel 
                   Variant=@Variant.Text>
            Cancel
        </MudButton>

        <MudButton Color=@Color.Primary 
                   Variant=@Variant.Filled 
                   OnClick=@SaveAsync>
            Save
        </MudButton>

    </DialogActions>

</MudDialog>