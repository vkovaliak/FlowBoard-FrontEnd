@using FlowBoard.Frontend.Domain.DTOs.Search
@using FlowBoard.Frontend.Domain.Enums
@using FlowBoard.Frontend.WebApp.Components.Common

<MudDialog>

    <TitleContent>
        <div>
            <MudText Typo=@Typo.h5 Style="font-weight: 700;">
                Invite on Board
            </MudText>
            <MudText Typo=@Typo.body2 Class="mt-2">
                Invite people to collaborate on this board
            </MudText>
        </div>
    </TitleContent>

    <DialogContent>

        @if (!IsOwnerPro)
        {
            <MudText Typo=@Typo.subtitle2 
                     Color=@Color.Secondary 
                     Class="mb-2">
                <b>@CurrentMembersCount</b> / @FreeMaxMembers members used
            </MudText>
        }

        @if (LimitReached)
        {
            <MudAlert Severity=@Severity.Warning
                      Dense=@true
                      Class="mb-4">
                Free plan allows up to @FreeMaxMembers members per board.

                <MudLink OnClick=@Upgrade
                         Style="font-weight: 600; cursor: pointer;">
                    Upgrade to Pro
                </MudLink>

                for unlimited members.
            </MudAlert>
        }

        <MudText Typo=@Typo.subtitle1
                    Class="mb-3"
                    Style="font-weight: 600;">
            Invite by email
        </MudText>

        <MudAutocomplete T=@UserSearchDto
                @bind-Value=@_selectedUser
                SearchFunc=@SearchUsersAsync
                ToStringFunc=@(u => u?.EmailAddress ?? string.Empty)
                Placeholder="Enter email address..."
                Variant=@Variant.Outlined
                Margin=@Margin.Dense
                Adornment=@Adornment.Start
                AdornmentIcon=@Icons.Material.Outlined.Email
                MinCharacters="3"
                Clearable=@true
                Disabled=@LimitReached
                Class="mb-4">

            <ItemTemplate Context="user">

                <MudStack Row=@true 
                          AlignItems=@AlignItems.Center 
                          Spacing="3">

                    <UserAvatar UserName=@user.UserName
                                AvatarUrl=@user.AvatarUrl
                                Size=@Size.Small />

                    <div>
                        <MudText Typo=@Typo.body2>
                            @user.UserName
                        </MudText>

                        <MudText Typo=@Typo.caption 
                                 Color=@Color.Secondary>
                            @user.EmailAddress
                        </MudText>
                    </div>

                </MudStack>

            </ItemTemplate>

        </MudAutocomplete>

        <MudText Typo=@Typo.subtitle1
                    Class="mb-2"
                    Style="font-weight: 600;">
            Select a role
        </MudText>

        <MudSelect @bind-Value=@_role
                   Variant=@Variant.Outlined
                   Margin=@Margin.Normal
                   Adornment=@Adornment.Start
                   AdornmentIcon=@GetRoleIcon(_role)
                   ToStringFunc=@RoleToString
                   Disabled=@LimitReached
                   AnchorOrigin=@Origin.BottomCenter>

            @foreach (var role in AvailableRoles)
            {
                <MudSelectItem T=@BoardRole Value=@role>

                    <MudStack Row=@true
                            AlignItems=@AlignItems.Center
                            Spacing="3"
                            Class="py-0">

                        <MudIcon Icon=@GetRoleIcon(role)
                                Size=@Size.Small
                                Color=@Color.Default />

                        <div>
                            <MudText Typo=@Typo.body2
                                    Style="font-weight: 500;">
                                @role.ToString()
                            </MudText>

                            <MudText Typo=@Typo.caption
                                    Color=@Color.Secondary>
                                @GetRoleDescription(role)
                            </MudText>
                        </div>

                    </MudStack>

                </MudSelectItem>
            }

        </MudSelect>

        <MudText Typo=@Typo.caption
                Color=@Color.Secondary
                Class="mt-2 d-block">
            @GetRoleDescription(_role)
        </MudText>

        @if (IsPublic)
        {
            <MudDivider Class="my-2" />

            <MudText Typo=@Typo.subtitle1
                     Class="mb-2"
                     Style="font-weight: 600;">
                Share link
            </MudText>

            <MudText Typo=@Typo.caption
                     Color=@Color.Secondary
                     Class="mb-3 d-block">
                Anyone with this link can view the board.
            </MudText>

            <MudStack Row=@true Spacing="2" 
                      AlignItems=@AlignItems.Center>

                <MudTextField Value=@BoardLink
                              ReadOnly=@true
                              Variant=@Variant.Outlined
                              Margin=@Margin.Dense
                              Adornment=@Adornment.Start
                              AdornmentIcon=@Icons.Material.Filled.Link
                              Class="flex-grow-1" />

                <MudButton Color=@Color.Primary
                           Variant=@Variant.Filled
                           StartIcon=@Icons.Material.Filled.ContentCopy
                           OnClick=@CopyLinkAsync
                           Style="text-transform: none;">
                    Copy
                </MudButton>

            </MudStack>
        }
        else
        {
            <MudAlert Severity=@Severity.Info 
                      Dense=@true>
                This board is private. Only invited members can access it.
            </MudAlert>
        }

        <MudDivider Class="mb-5" />

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel
                   Variant=@Variant.Outlined
                   Class="mr-3"
                   Style="text-transform: none;">
            Cancel
        </MudButton>

        <MudButton Color=@Color.Primary
                   Variant=@Variant.Filled
                   StartIcon=@Icons.Material.Filled.Send
                   OnClick=@Submit
                   Disabled=@(LimitReached || _selectedUser is null)
                   Class="mr-4"
                   Style="text-transform: none;">
            Send Invite
        </MudButton>

    </DialogActions>

</MudDialog>