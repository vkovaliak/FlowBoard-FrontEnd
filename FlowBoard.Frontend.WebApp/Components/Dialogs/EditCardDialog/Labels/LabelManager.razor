@using FlowBoard.Frontend.WebApp.Components.Labels

<MudStack Spacing="1">

    <MudText Typo=@Typo.caption 
             Color=@Color.Secondary 
             Class="ml-1">
        Labels
    </MudText>

    <MudStack Row=@true Spacing="1" 
              Class="flex-wrap">

        @foreach (var label in AttachedLabels)
        {
            <LabelChip Label=@label 
                       OnClose=@(() => DetachAsync(label)) />
        }

        <MudIconButton Icon=@Icons.Material.Filled.Add
                       Size=@Size.Small
                       Variant=@Variant.Outlined
                       Style="border-radius: 6px; padding: 4px;"
                       OnClick=@TogglePopover />

    </MudStack>

    <MudPopover Open=@_isOpen
                AnchorOrigin=@Origin.BottomLeft
                TransformOrigin=@Origin.TopLeft
                Style="padding: 12px; min-width: 260px;">

        <MudText Typo=@Typo.subtitle2 
                 Class="mb-2">
            Board labels
        </MudText>

        @if (_boardLabels.Count == 0)
        {
            <MudText Typo=@Typo.caption 
                     Color=@Color.Secondary 
                     Class="mb-2">
                No labels yet.
            </MudText>
        }

        @foreach (var label in _boardLabels)
        {
            <div class="label-row" @onclick=@(() => ToggleAsync(label))>

                <div style=@($"flex-grow:1; background-color:{label.Color}; " +
                              "color:white; border-radius:4px; padding:4px 10px; " +
                              "font-size:13px; font-weight:500;")>
                    @label.Name
                </div>

                @if (IsAttached(label))
                {
                    <MudIcon Icon=@Icons.Material.Filled.CheckCircle
                             Color=@Color.Primary
                             Size=@Size.Small />
                }
            </div>
        }

        <MudDivider Class="my-2" />

        <MudStack Spacing="1">

            <MudButton Variant=@Variant.Text
                       Color=@Color.Primary
                       Size=@Size.Small
                       StartIcon=@Icons.Material.Filled.Add
                       FullWidth=@true
                       Style="justify-content: flex-start; text-transform: none;"
                       OnClick=@OpenCreateAsync>
                Add new label
            </MudButton>

            <MudButton Variant=@Variant.Text
                       Color=@Color.Default
                       Size=@Size.Small
                       StartIcon=@Icons.Material.Filled.Settings
                       FullWidth=@true
                       Style="justify-content: flex-start; text-transform: none;"
                       OnClick=@OpenManageAsync>
                Manage labels
            </MudButton>

        </MudStack>

    </MudPopover>

    @if (_isOpen)
    {
        <MudOverlay Visible=@_isOpen
                    OnClick=@TogglePopover
                    Style="background: transparent;" />
    }

</MudStack>