@using FlowBoard.Frontend.WebApp.Components.Common

<MudStack Spacing="2">

    <MudText Typo=@Typo.caption
             Color=@Color.Secondary>
        Assignees
    </MudText>

    @if (Assignees.Any())
    {
        <MudStack Row=@true 
                  Wrap=@Wrap.Wrap 
                  Spacing="1">

            @foreach (var assignee in Assignees)
            {
                <MudChip T=@string
                         OnClose=@(() => RemoveAssigneeAsync(assignee))
                         Color=@Color.Default
                         Style="padding-left: 4px;">

                    <div style="display: flex; 
                                align-items: 
                                center; gap: 6px;">

                        <UserAvatar UserName=@assignee.UserName
                                    AvatarUrl=@assignee.AvatarUrl
                                    Size=@Size.Small
                                    SizeStyle="width: 24px; 
                                               height: 24px; 
                                               font-size: 12px;" />
                        @assignee.UserName
                    </div>
                </MudChip>
            }

        </MudStack>
    }

    <MudSelect T=Guid?
               Label="Assign member"
               Value=@_selectedUserId
               ValueChanged=@AssignUserAsync
               Variant=@Variant.Outlined>

        @foreach (var member in AvailableMembers)
        {
            <MudSelectItem Value=@((Guid?)member.UserId)>

                <div style="display: flex; 
                            align-items: center; 
                            gap: 8px;">

                    <UserAvatar UserName=@member.UserName
                                AvatarUrl=@member.AvatarUrl
                                Size=@Size.Small
                                SizeStyle="width: 24px; height: 24px; 
                                           font-size: 12px;" />

                    @member.UserName
                </div>

            </MudSelectItem>
        }

    </MudSelect>

</MudStack>