@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Shared

<MudStack Spacing="2">

    @if (_useRichEditor)
    {
        <RichTextEditor @bind-Value=@_message />
    }
    else
    {
        <MudTextField T=@string
                      @bind-Value=@_message
                      Placeholder="Write a comment..."
                      Variant=@Variant.Outlined
                      Lines="1"
                      Immediate=@true />
    }

    <AttachmentUploader @ref=@_uploader />

    <MudStack Row=@true
              Justify=@Justify.FlexEnd
              AlignItems=@AlignItems.Center >
                

        <MudStack Row=@true Spacing="3">

            @if (!_useRichEditor)
            {
                <MudIconButton Icon=@Icons.Material.Outlined.EditAttributes
                               OnClick=@EnableRichEditor
                               Size=@Size.Medium/>
            }
            else
            {
                <MudIconButton Icon=@Icons.Material.Outlined.TextFields
                               OnClick=@DisableRichEditor>
                </MudIconButton>
            }

            <MudButton Variant=@Variant.Filled
                       Size=@Size.Medium
                       Color=@Color.Primary
                       Disabled=@(string.IsNullOrWhiteSpace(_message) || _isSubmitting)
                       OnClick=@SubmitAsync>

                @if (_isSubmitting)
                {
                    <MudProgressCircular Size=@Size.Small
                                         Indeterminate=@true
                                         Class="mr-2" />
                }

                Add
            </MudButton>

        </MudStack>

    </MudStack>

</MudStack>