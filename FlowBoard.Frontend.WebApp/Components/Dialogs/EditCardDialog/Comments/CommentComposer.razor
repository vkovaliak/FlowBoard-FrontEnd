@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Shared
@using FlowBoard.Frontend.WebApp.Components.Common

<div class="comment-composer">

    @if (_useRichEditor)
    {
        <RichTextEditor @bind-Value=@_message />

        <div class="composer-actions-row">

            <label for=@_inputId 
                   class="composer-attach-btn" 
                   title="Attach files">

                <MudIcon Icon=@Icons.Material.Outlined.AttachFile 
                         Size=@Size.Small />
            </label>

            <MudIconButton Icon=@Icons.Material.Outlined.TextFields
                           OnClick=@ToggleRichEditor
                           Size=@Size.Small  />

            <MudSpacer />

            <MudIconButton Icon=@Icons.Material.Filled.Send
                           Color=@Color.Primary
                           Size=@Size.Small
                           Disabled=@(string.IsNullOrWhiteSpace(_message) || _isSubmitting)
                           OnClick=@SubmitAsync />
        </div>
    }
    else
    {
        <div class="composer-input-row">

            <div class="composer-field" style="position: relative;">

                <MudTextField T=@string
                              Value=@_message
                              ValueChanged=@OnMessageChanged
                              Placeholder="Write a comment..."
                              Variant=@Variant.Outlined
                              Immediate=@true
                              Lines="2"
                              Margin=@Margin.Dense
                              Class="composer-textfield" />
                
                @if (_showMentions)
                {
                    <div class="mention-dropdown">
                        @foreach (var member in _filteredMembers)
                        {
                            <div class="mention-item"
                                @onclick=@(() => SelectMention(member))>

                                <UserAvatar UserName=@member.UserName
                                            AvatarUrl=@member.AvatarUrl
                                            Size=@Size.Small
                                            SizeStyle="width:24px; height:24px;
                                                    font-size:11px;" />
                                                    
                                <span>@member.UserName</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <MudIconButton Icon=@Icons.Material.Filled.Send
                           Class="mb-3"
                           Color=@Color.Primary
                           Size=@Size.Medium
                           Disabled=@(string.IsNullOrWhiteSpace(_message) || _isSubmitting)
                           OnClick=@SubmitAsync />
        </div>

        <div class="composer-actions-row">

            <label for=@_inputId 
                   class="composer-attach-btn" 
                   title="Attach files">

                <MudIcon Icon=@Icons.Material.Outlined.AttachFile 
                         Size=@Size.Small />
            </label>

            <MudIconButton Icon=@Icons.Material.Outlined.EditAttributes
                           OnClick=@ToggleRichEditor
                           Size=@Size.Small />
        </div>
    }

    <InputFile OnChange=@OnFilesSelected
               multiple
               id=@_inputId
               style="display: none;" />

    @if (_pendingFiles.Any())
    {
        <div class="composer-attachments">

            @foreach (var file in _pendingFiles)
            {
                <div class="composer-attach-chip">

                    <MudIcon Icon=@GetFileIcon(file.ContentType)
                             Size=@Size.Small 
                             Class="mr-1" />

                    <span class="composer-attach-name">
                        @file.Name
                    </span>

                    <span class="composer-attach-size">
                        @FormatSize(file.Size)
                    </span>

                    @if (_uploadingFile == file.Name)
                    {
                        <MudProgressCircular Size=@Size.Small
                                             Indeterminate=@true Class="ml-2" />
                    }
                    else
                    {
                        <MudIconButton Icon=@Icons.Material.Filled.Close
                                       Size=@Size.Small
                                       Color=@Color.Error
                                       OnClick=@(() => RemoveFile(file)) />
                    }
                </div>
            }
        </div>
    }

</div>