@using System.Globalization
@using FlowBoard.Frontend.WebApp.Components.Common
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Shared

<MudPaper Class="pa-3 my-1 bg-light" Outlined=@true>

    <MudStack Row=@true Justify=@Justify.SpaceBetween 
              AlignItems=@AlignItems.Center>

        <MudStack Row=@true Spacing="2" 
                  AlignItems=@AlignItems.Center>

            <UserAvatar UserName=@Comment.UserName
                        AvatarUrl=@Comment.AvatarUrl
                        Size=@Size.Small
                        SizeStyle="width: 28px; height: 28px; 
                                   font-size: 12px;" />

            <MudText Typo=@Typo.caption 
                     Class="font-weight-bold">
                @Comment.UserName
            </MudText>

            <MudText Typo=@Typo.caption Color=@Color.Secondary>
                @Comment.CreatedAt.ToString("d MMM, HH:mm", CultureInfo.InvariantCulture)
            </MudText>

        </MudStack>

        @if (!_isEditing && CanManage)
        {
            <MudMenu Icon=@Icons.Material.Filled.MoreVert
                    Size=@Size.Small
                    Dense=@true
                    AnchorOrigin=@Origin.BottomRight
                    TransformOrigin=@Origin.TopRight>

                <MudMenuItem Icon=@Icons.Material.Filled.Edit
                            OnClick=@StartEdit>
                    Edit
                </MudMenuItem>

                <MudMenuItem Icon=@Icons.Material.Filled.Delete
                            IconColor=@Color.Error
                            OnClick=@(() => OnDelete.InvokeAsync(Comment.Id))>
                    Delete
                </MudMenuItem>

            </MudMenu>
        }
    </MudStack>

    @if (_isEditing)
    {
        <MudStack Class="mt-2" Spacing="2">

            @if (_useRichEditor)
            {
                <RichTextEditor @bind-Value=@_editMessage />
            }
            else
            {
                <MudTextField T=@string
                      @bind-Value=@_editMessage
                      Placeholder="Edit a comment..."
                      Variant=@Variant.Outlined 
                      AutoFocus="true"
                      Lines="5" />
            }
            <MudStack Row=@true 
                      Justify=@Justify.FlexEnd 
                      Spacing="3">
                      
                @if (!_useRichEditor)
                {
                    <MudIconButton Icon=@Icons.Material.Outlined.EditAttributes
                                OnClick=@EnableRichEditor
                                Size=@Size.Medium/>
                }
                else
                {
                    <MudIconButton Icon=@Icons.Material.Outlined.TextFields
                                OnClick=@DisableRichEditor>
                    </MudIconButton>
                }
                <MudButton Size=@Size.Small Variant=@Variant.Text
                        Color=@Color.Secondary OnClick=@CancelEdit>
                    Cancel
                </MudButton>

                <MudButton Size=@Size.Small Variant=@Variant.Filled
                        Color=@Color.Primary
                        Disabled=@string.IsNullOrWhiteSpace(_editMessage)
                        OnClick=@SaveAsync>
                    Save
                </MudButton>

            </MudStack>

        </MudStack>
    }
    else
    {
        <MudText Typo=@Typo.body2 Class="mt-1" 
                 Style="white-space: pre-wrap;
                        word-wrap: break-word;
                        overflow-wrap: anywhere;
                        word-break: break-word;
                        max-width: 100%;">
            @((MarkupString)Comment.Message)
        </MudText>

         <AttachmentList Attachments=@Comment.Attachments 
                         OnDelete="OnDeleteAttachment"/>
    }
</MudPaper>