
<MudStack Spacing="2" 
          Class="mt-4">

    @if (CanEdit)
    {
        <CommentComposer BoardId=@BoardId
                         OnCreateComment=@CreateCommentAsync
                         Members=@Members
                         CardId=@CardId />
    }

    <MudStack Spacing="2" Style="overflow-y: auto;" Class="mt-2">
        @if (_isLoading)
        {
            <div style="overflow: hidden; max-height: 100%;">

                <MudStack AlignItems=@AlignItems.End>

                    <MudSkeleton SkeletonType=@SkeletonType.Text 
                                Height=20px Width=42%/>

                </MudStack>

                <MudSkeleton SkeletonType=@SkeletonType.Text 
                             Height="20px" Width=50%/>

                <MudSkeleton SkeletonType=@SkeletonType.Text 
                             Height="20px" Width=32%/>

                <MudStack AlignItems=@AlignItems.End>

                    <MudSkeleton SkeletonType=@SkeletonType.Text 
                                Height="20px" Width=50%/>

                </MudStack>
            </div>
        }
        else if (!_comments.Any())
        {
            <MudText Typo=@Typo.body2 
                     Color=@Color.Secondary>
                No comments yet.
            </MudText>
        }
        else
        {
            @foreach (var comment in _comments)
            {
                <CommentItem Comment=@comment
                             OnUpdate=@UpdateCommentAsync
                             OnDelete=@DeleteCommentAsync 
                             OnDeleteAttachment=@DeleteCommentAttachmentAsync/>
            }
        }
    </MudStack>
    
</MudStack>