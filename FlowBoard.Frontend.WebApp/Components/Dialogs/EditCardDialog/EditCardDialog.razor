@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Description
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Comments
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Shared
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Assignees
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.DueDate
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Labels
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.ListSelector
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Checklist
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Name;

<MudDialog Class="card-side-panel">

    <TitleContent>
        <MudStack Row=@true 
                  Justify=@Justify.SpaceBetween 
                  AlignItems=@AlignItems.Center 
                  Style="width: 100%;">

            <MudText Typo=@Typo.h6>
                <MudIcon Icon=@Icons.Material.Filled.CreditCard 
                         Class="mr-2" />
                Card details
            </MudText>
            <MudIconButton Icon=@Icons.Material.Filled.Close 
                           Size=@Size.Small 
                           OnClick=@Close />
        </MudStack>
    </TitleContent>

    <DialogContent>

        @if (_isLoading)
        {
            <MudStack AlignItems=@AlignItems.Center 
                      Class="pa-8">
                <MudProgressCircular Indeterminate=@true 
                                     Color=@Color.Primary />
            </MudStack>
        }
        else if (_card is null)
        {
            <MudAlert Severity=@Severity.Warning>
                This card no longer exists.
            </MudAlert>
        }
        else
        {
            <MudStack Spacing="4">

                <CardNameEditor BoardId=@BoardId
                                CardId=@CardId
                                Name=@_card.Name />

                <CardListSelector BoardId=@BoardId
                                  CardId=@CardId
                                  CurrentListId=@_card.ListId
                                  Lists=@_board!.Lists />

                <CardAssigneeSelector BoardId=@BoardId
                                      CardId=@CardId
                                      Assignees=@_card.Assignees
                                      BoardMembers=@_board.Members />

                <CardDueDatePicker BoardId=@BoardId
                                   CardId=@CardId
                                   DueDate=@_card.DueDate
                                   IsCompleted=@_card.IsCompleted />

                <LabelManager BoardId=@BoardId
                              CardId=@CardId
                              AttachedLabels=@_card.Labels />

                <ChecklistSection BoardId=@BoardId
                                  CardId=@CardId
                                  Items=@_card.ChecklistItems />

                <CardDescriptionEditor BoardId=@BoardId
                                       CardId=@CardId
                                       Description=@_card.Description />

                <AttachmentList Attachments=@_card.Attachments
                                OnDelete=@DeleteCardAttachmentAsync />

                <MudDivider Class="my-2" />

                <CardCommentsSection BoardId=@BoardId CardId=@CardId />

            </MudStack>
        }

    </DialogContent>

</MudDialog>