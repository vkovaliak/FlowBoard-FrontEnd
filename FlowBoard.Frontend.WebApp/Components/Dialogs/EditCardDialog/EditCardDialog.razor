@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Description
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Comments
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Shared
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Assignees
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.DueDate
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Labels
@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.ListSelector


<MudDialog Class="card-side-panel">

    <TitleContent>

        <MudStack Row=@true 
                  Justify=@Justify.SpaceBetween 
                  AlignItems=@AlignItems.Center 
                  Style="width: 100%;">

            <MudText Typo=@Typo.h6>

                <MudIcon Icon=@Icons.Material.Filled.CreditCard 
                         Class="mr-2" />

                Edit Card
            </MudText>

            <MudIconButton Icon=@Icons.Material.Filled.Close 
                           Size=@Size.Small 
                           OnClick=@Cancel />

        </MudStack>

    </TitleContent>

    <DialogContent>

        <EditForm Model="@_model">

            <DataAnnotationsValidator />

            <MudStack Spacing="4">

                <MudTextField @bind-Value=@_model.Name 
                              Label="Card Name" 
                              Variant=@Variant.Outlined 
                              Margin=@Margin.Dense
                              Required=@true RequiredError="Card name cannot be empty" For=@(() => _model.Name) />
                
                <CardListSelector BoardId=@BoardId
                                  CardId=@CardId
                                  CurrentListId=@CurrentListId
                                  Lists=@Lists
                                  OnMoved=@OnCardMoved />

                <CardAssigneeSelector BoardId="@BoardId"
                                      CardId="@CardId"
                                      Assignees="@Assignees"
                                      BoardMembers="@BoardMembers" />

                <CardDueDatePicker @bind-DueDate=@_model.DueDate
                                   IsCompleted=@_isCompleted />
                
                <LabelManager BoardId=@BoardId
                              CardId=@CardId
                              AttachedLabels=@CardLabels
                              OnChanged=@OnLabelsChanged />

                <CardDescriptionEditor BoardId=@BoardId
                                       CardId=@CardId 
                                       @bind-Description=@_model.Description 
                                       OnAttachmentUploaded=@HandleNewAttachment/>
                
                <AttachmentList Attachments=@_attachments 
                                OnDelete=@DeleteCardAttachmentAsync/>

                <MudDivider Class="my-2" />

                <CardCommentsSection BoardId=@BoardId CardId=@CardId />

            </MudStack>

        </EditForm>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel 
                   Variant=@Variant.Text>
            Cancel
        </MudButton>

        <MudButton Color=@Color.Primary 
                   Variant=@Variant.Filled 
                   OnClick=@Save>
            Save
        </MudButton>

    </DialogActions>

</MudDialog>
