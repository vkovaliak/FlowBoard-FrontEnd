<MudStack Spacing="1">

    <MudText Typo=@Typo.subtitle2 
             Color=@Color.Default 
             Class="ml-1"
             Style="font-weight: 500">
        In list
    </MudText>

    <MudSelect T=@Guid
            Value=@CurrentListId
            ValueChanged=@OnListChangedAsync
            Variant=@Variant.Outlined
            Margin=@Margin.Dense
            Dense=@true
            ReadOnly=@(!CanEdit)
            Disabled=@(!CanEdit)>

        @foreach (var list in Lists)
        {
            <MudSelectItem T=@Guid Value=@list.Id>
                @list.Name
            </MudSelectItem>
        }
    </MudSelect>

</MudStack>