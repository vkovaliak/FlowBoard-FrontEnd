@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Shared

<MudStack Spacing="1">

    <MudText Typo=@Typo.caption Color=@Color.Secondary Class="ml-1">
        Description
    </MudText>

    @if (!_isEditing)
    {
        <MudPaper Class="pa-2 mb-2" Outlined=@true>
            <InputFile OnChange=@HandleFileSelected multiple />
        </MudPaper>

        <MudPaper Outlined=@true
                  Class="pa-3"
                  Style="cursor: pointer; min-height: 80px;
                         border-color: var(--mud-palette-lines-inputs);"
                  @onclick=@(() => _isEditing = true)>

            @if (string.IsNullOrWhiteSpace(Description))
            {
                <MudText Typo=@Typo.body2 Color=@Color.Secondary
                         Style="font-style: italic;">
                    Add a more detailed description (Click to format text)...
                </MudText>
            }
            else
            {
                <MudText Typo=@Typo.body2>
                    @((MarkupString)Description)
                </MudText>
            }
        </MudPaper>
    }
    else
    {
        <RichTextEditor Value=@Description
                        ValueChanged=@OnDescriptionChanged />

        <MudStack Row=@true Justify=@Justify.FlexEnd Class="mt-1">
            <MudButton Variant=@Variant.Text
                       Color=@Color.Secondary
                       Size=@Size.Small
                       OnClick=@(() => _isEditing = false)>
                Close Editor
            </MudButton>
        </MudStack>
    }
</MudStack>