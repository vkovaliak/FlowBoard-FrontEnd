@using FlowBoard.Frontend.WebApp.Components.Dialogs.EditCardDialog.Shared

<MudStack Spacing="1">

    <MudStack Row=@true
              Justify=@Justify.SpaceBetween
              AlignItems=@AlignItems.Center>

        <MudText Typo=@Typo.caption
                 Color=@Color.Secondary
                 Class="ml-1">
            Description
        </MudText>

        <div style="position: relative; display: inline-flex;
                    width: 36px; height: 36px;
                    align-items: center; justify-content: center;
                    border-radius: 50%; cursor: pointer;"
            title="Attach files">

            <MudIcon Icon=@Icons.Material.Filled.AttachFile
                    Color=@Color.Default
                    Size=@Size.Small />

            <InputFile OnChange=@HandleFilesSelected multiple
                    style="position: absolute; inset: 0;
                            opacity: 0; cursor: pointer;" />
        </div>

    </MudStack>

    @if (!_isEditing)
    {
        <MudPaper Outlined=@true Class="pa-3"
                  Style="cursor: pointer; min-height: 80px;
                         border-color: var(--mud-palette-lines-inputs);"
                  @onclick=@(() => _isEditing = true)>

            @if (string.IsNullOrWhiteSpace(Description))
            {
                <MudText Typo=@Typo.body2 Color=@Color.Secondary
                         Style="font-style: italic;">
                    Add a more detailed description...
                </MudText>
            }
            else
            {
                <MudText Typo=@Typo.body2>
                    @((MarkupString)Description)
                </MudText>
            }
        </MudPaper>
    }
    else
    {
        <RichTextEditor @bind-Value=@_description />

        <MudStack Row=@true Justify=@Justify.FlexEnd Class="mt-1">
            <MudButton Variant=@Variant.Text
                       Color=@Color.Secondary
                       Size=@Size.Small
                       OnClick=@(() => _isEditing = false)>
                Close Editor
            </MudButton>
        </MudStack>
    }
</MudStack>