@using FlowBoard.Frontend.Domain.Enums

<MudDialog>

    <TitleContent>

        <MudText Typo=@Typo.h6>

            <MudIcon Icon=@Icons.Material.Filled.PersonAdd 
                     Class="mr-2" />
            Invite to Board
        </MudText>
        
    </TitleContent>

    <DialogContent>

        <MudText Typo=@Typo.body2 
                 Class="mb-4" 
                 Color=@Color.Secondary>
            Enter the email address and choose a role for the user
            you want to invite to this board.
        </MudText>

        <MudStack Spacing="3">

            <MudTextField @bind-Value=@_email
                          Label="Email Address"
                          Variant=@Variant.Outlined
                          InputType=@InputType.Email
                          Adornment=@Adornment.Start
                          AdornmentIcon=@Icons.Material.Filled.Email
                          Autofocus=@true />

            <MudSelect @bind-Value=@_role
                       Label="Role"
                       Variant=@Variant.Outlined
                       Adornment=@Adornment.Start
                       AdornmentIcon=@Icons.Material.Filled.AdminPanelSettings>

                <MudSelectItem Value=@BoardRole.Member>

                    <MudStack Row=@true 
                              AlignItems=@AlignItems.Center 
                              Spacing="2">

                        <MudIcon Icon=@Icons.Material.Filled.Edit 
                                 Size=@Size.Small />
                        <div>

                            <MudText Typo=@Typo.body2>
                                Member
                            </MudText>

                            <MudText Typo=@Typo.caption 
                                      Color=@Color.Secondary>
                                Can view and edit the board
                            </MudText>

                        </div>

                    </MudStack>

                </MudSelectItem>

                <MudSelectItem Value=@BoardRole.Viewer>

                    <MudStack Row=@true 
                              AlignItems=@AlignItems.Center 
                              Spacing="2">

                        <MudIcon Icon=@Icons.Material.Filled.Visibility 
                                 Size=@Size.Small />
                        <div>

                            <MudText Typo=@Typo.body2>
                                Viewer
                            </MudText>
                            
                            <MudText Typo=@Typo.caption 
                                     Color=@Color.Secondary>
                                Can only view the board
                            </MudText>

                        </div>
                    </MudStack>
                </MudSelectItem>

            </MudSelect>

        </MudStack>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel 
                   Style="text-transform: none;">
            Cancel
        </MudButton>

        <MudButton Color=@Color.Primary
                   Variant=@Variant.Filled
                   OnClick=@Submit
                   Disabled=@string.IsNullOrWhiteSpace(_email)
                   Style="text-transform: none;">
            Invite
        </MudButton>

    </DialogActions>

</MudDialog>