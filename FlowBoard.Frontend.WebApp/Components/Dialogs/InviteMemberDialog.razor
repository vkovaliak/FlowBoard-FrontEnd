<MudDialog>

    <TitleContent>

        <MudText Typo=@Typo.h6>

            <MudIcon Icon=@Icons.Material.Filled.PersonAdd
                     Class="mr-2" />
            Invite to Board

        </MudText>

    </TitleContent>

    <DialogContent>

        <MudText Typo=@Typo.body2 Class="mb-4" 
                 Color=@Color.Secondary>
                Enter the email address of the user you want to invite to this board.
        </MudText>

        <MudTextField @bind-Value=@_email
                      Label="Email Address"
                      Variant=@Variant.Outlined
                      InputType=@InputType.Email
                      Adornment=@Adornment.Start
                      AdornmentIcon=@Icons.Material.Filled.Email
                      Autofocus=@true />

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel Style="text-transform: none;">
                   Cancel
        </MudButton>

        <MudButton Color=@Color.Primary
                   Variant=@Variant.Filled
                   OnClick=@Submit
                   Disabled=@string.IsNullOrWhiteSpace(_email)
                   Style="text-transform: none;">
                   Invite
        </MudButton>

    </DialogActions>

</MudDialog>