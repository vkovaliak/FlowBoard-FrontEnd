@using FlowBoard.Frontend.WebApp.Components.Common

<MudDialog>

    <DialogContent>

        <MudAlert Severity=@Severity.Warning
                  Variant=@Variant.Outlined
                  Class="mb-3">
            You will become an <b>Admin</b> after transferring ownership.
            This action cannot be undone by you alone.
        </MudAlert>

        <MudText Typo=@Typo.body2 
                 Class="mb-2">
            Select the new owner:
        </MudText>

        <div style="max-height: 300px; overflow-y: auto;">

            <MudRadioGroup T=@Guid
                           Value=@_selectedId
                           ValueChanged=@Select>

                @foreach (var member in Candidates)
                {
                    <div class="d-flex align-center px-2 py-2"
                        style="gap: 12px; cursor: pointer; border-radius: 6px;
                                background-color: @(IsSelected(member.UserId)
                                    ? "#EFF6FF" : "transparent");"
                        @onclick=@(() => Select(member.UserId))>

                        <MudRadio T=@Guid
                                Value=@member.UserId
                                Color=@Color.Primary
                                Dense=@true />

                        <UserAvatar UserName=@member.UserName
                                    AvatarUrl=@member.AvatarUrl
                                    Size=@Size.Medium />

                        <div style="min-width: 280px;">

                            <MudText Typo=@Typo.body2 
                                    Class="font-weight-bold">
                                @member.UserName
                            </MudText>

                            <MudText Typo=@Typo.caption 
                                    Color=@Color.Secondary>
                                @member.EmailAddress
                            </MudText>
                            
                        </div>

                    </div>
                }

            </MudRadioGroup>

        </div>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick=@Cancel>Cancel</MudButton>

        <MudButton Color=@Color.Error
                   Variant=@Variant.Filled
                   Disabled=@(_selectedId == Guid.Empty)
                   OnClick=@Submit>
            Transfer Ownership
        </MudButton>

    </DialogActions>

</MudDialog>