<div style=@($"border: 1px solid var(--mud-palette-divider); " +
             $"min-height: 110px; padding: 10px; " +
             $"background-color: {(IsCurrentMonth ? "white" : "#FAFBFC")}; " +
             $"overflow: hidden;")>

    <div class="d-flex justify-begin mb-1">
        @if (IsToday)
        {
            <span style="background-color: var(--mud-palette-primary);
                         color: white; border-radius: 50%;
                         width: 27px; height: 27px; display: flex;
                         align-items: center; justify-content: center;
                         font-size: 16px; font-weight: 600;">
                @Date.Day
            </span>
        }
        else
        {
            <span style=@($"font-size: 16px; padding: 2px 6px; font-weight: 500;" +
                          $"color: {(IsCurrentMonth ? "#000" : "#ADB5BD")};")>
                @Date.Day
            </span>
        }
    </div>

    @foreach (var task in Tasks.Take(2))
    {
        <CalendarTaskItem Task=@task OnClick=@OnTaskClick />
    }

    @if (Tasks.Count > 2)
    {
        <div style="font-size: 12px; color: var(--mud-palette-primary);
                    padding: 2px 4px; cursor: pointer;  font-weight: 500;"
             @onclick=@OpenDayDialogAsync
             @onclick:stopPropagation=@true>
            + @(Tasks.Count - 2) more
        </div>
    }

</div>