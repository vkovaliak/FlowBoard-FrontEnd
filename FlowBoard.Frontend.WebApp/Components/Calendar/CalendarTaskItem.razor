<div class="d-flex align-center px-2 py-2"
     style="gap: 5px; cursor: pointer; border-radius: 8px;
            padding: 2px 4px; font-size: 13px;
            font-weight: 600;
            border: 2px solid #b4b4b43c;
            background-color: #fff; margin-bottom: 4px;
            overflow: hidden;"
     @onclick=@(() => OnClick.InvokeAsync(Task))
     @onclick:stopPropagation=@true>

    @foreach (var label in Task.Labels.Take(3))
    {
        <span style=@($"display: inline-block;"+
                      $" width: 10px; height: 10px; " +
                      $"border-radius: 50%;"+
                      $" background-color: {label.Color}; " +
                      $"flex-shrink: 0;")></span>
    }
    @if (Task.Labels.Count == 0)
    {
        <span style="display: inline-block; 
                     width: 10px; height: 10px;
                     border-radius: 50%; 
                     background-color: #ADB5BD;
                     flex-shrink: 0;"></span>
    }

    <span style="overflow: hidden;
                 text-overflow: ellipsis;
                 white-space: nowrap;">
        @Task.Name
    </span>

</div>