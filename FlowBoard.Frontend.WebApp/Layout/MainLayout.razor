@using FlowBoard.Frontend.WebApp.Components.Common
@using FlowBoard.Frontend.WebApp.Components.Chat
@using FlowBoard.Frontend.WebApp.Components.Notifications;
@inherits LayoutComponentBase

<MudLayout>

    <MudAppBar Elevation="1" 
               Style="background-color: #1E293B; color: #F1F5F9;">

        <MudStack Row=@true AlignItems=@AlignItems.Center Spacing="4">

            <MudImage Src="images/logo.png"
                    Alt="Flow Board"
                    Width="32"
                    Height="32"
                    Style="border-radius: 8px;" />

            <MudText Typo=@Typo.h6
                    Style="font-weight: 700;">
                Flow Board
            </MudText>

        </MudStack>


        <MudIconButton Icon=@Icons.Material.Filled.Menu
                   Color=@Color.Inherit
                   OnClick=@ToggleDrawer
                   Class="ml-6" />
        
        <div class="ml-6" style="flex-grow: 1; max-width: 480px;">
            <SearchBar />
        </div>

        <MudSpacer />

        <MudButton Variant=@Variant.Filled
                   Color=@Color.Primary
                   StartIcon=@Icons.Material.Filled.Add
                   Size=@Size.Large
                   OnClick=@OpenCreateBoardDialogAsync
                   Class="mr-6"
                   Style="text-transform: none; font-weight: 500; 
                          border-radius: 6px">
            Create
        </MudButton>

        @if(UserState.IsPro)
        {
            <MudIconButton Icon=@Icons.Material.Filled.Chat
                           Color=@Color.Inherit
                           OnClick=@ToggleChat
                           Class="mr-3" />
        }

        <AuthorizeView>
            <Authorized>
                <MudStack Class="mr-6">
                    <NotificationBell />
                </MudStack>
            </Authorized>
        </AuthorizeView>

        @if (_currentUser != null)
        {
            <div class="user-menu">

                <div class="user-menu-trigger" 
                     @onclick=@ToggleUserMenu>

                    <UserAvatar UserName=@_currentUser.UserName
                                AvatarUrl=@_currentUser.AvatarUrl
                                Size=@Size.Small
                                SizeStyle="width:36px; height:36px;" />

                    <span class="username">
                        @_currentUser.UserName
                    </span>

                    <span class="arrow">▼</span>
                </div>

                @if (_isUserMenuOpen)
                {
                    <div class="user-menu-dropdown">

                        <div class="item" 
                             @onclick=@HandleProfileAsync>
                            My Profile
                        </div>

                        <div class="item danger" 
                             @onclick=@HandleLogoutAsync>
                            Log out
                        </div>

                        @if (!UserState.IsPro)
                        {
                            <div class="item warning"
                                        @onclick=@Upgrade>
                                Upgrade to Pro
                            </div>
                        }

                    </div>

                    <div class="backdrop" 
                         @onclick=@ToggleUserMenu></div>
                }
            </div>
        }
        else
        {
            <MudProgressCircular Color=@Color.Default
                                 Indeterminate=@true
                                 Size=@Size.Small />
        }

    </MudAppBar>

    <MudDrawer @bind-Open=@_drawerOpen
               Elevation="2"
               Variant=@DrawerVariant.Responsive
               ClipMode=@DrawerClipMode.Always>

        <NavMenu />

    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth=@MaxWidth.False Class="pa-4">
            @Body
        </MudContainer>
        
    </MudMainContent>

    <ChatPanel @bind-IsOpen=@_isChatOpen />

</MudLayout>