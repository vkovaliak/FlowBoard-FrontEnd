@using FlowBoard.Frontend.WebApp.Components.Subscription;

<MudNavMenu Class="custom-nav-menu d-flex flex-column" 
            Style="height: 100%;">

    <MudNavLink Href="/" 
                Icon=@Icons.Material.Filled.Dashboard 
                Match=@NavLinkMatch.All>

        <MudText Typo=@Typo.body1 
                 Class="font-weight-medium">
            Boards
        </MudText>

    </MudNavLink>

    <MudNavLink Href="/my-tasks" 
                Icon="@Icons.Material.Filled.Checklist">

        <div class="d-flex align-center justify-space-between" 
             style="width:100%;">

            <MudText Typo="Typo.body1" 
                     Class="font-weight-medium">
                My Tasks
            </MudText>

            @if (_myTasksCount > 0)
            {
                <MudChip T="string"
                        Size="Size.Small"
                        Color="Color.Primary"
                        Variant="Variant.Filled"
                        Class="ml-2 my-0">
                    @_myTasksCount
                </MudChip>
            }
        </div>

    </MudNavLink>

    <MudNavLink Href="/calendar" 
                Icon=@Icons.Material.Filled.CalendarMonth>

        <MudText Typo=@Typo.body1 
                 Class="font-weight-medium">
            Calendar
        </MudText>
        
    </MudNavLink>

    @if (_favorites.Any())
    {
        <MudText Typo=@Typo.caption
                 Class="px-4 mt-4 mb-2"
                 Style="color: #94A3B8; font-weight: 600;
                        letter-spacing: 0.5px; 
                        text-transform: uppercase;">
            Favorites
        </MudText>

        @foreach (var board in _favorites)
        {
            <MudNavLink Href=@($"/boards/{board.Id}")
                        Icon=@Icons.Material.Filled.Star
                        IconColor=@Color.Warning>

                <MudText Typo=@Typo.body1 
                         Class="font-weight-medium">
                    @board.Name
                </MudText>
                
            </MudNavLink>
        }
    }

    @if (!UserState.IsPro)
    {
        <div style="margin-top: auto; 
                    padding-bottom: 10px;">
            <UpgradeCard />
        </div>
    }

</MudNavMenu>